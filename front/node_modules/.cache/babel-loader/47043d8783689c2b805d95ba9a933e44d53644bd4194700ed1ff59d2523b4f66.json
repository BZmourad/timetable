{"ast":null,"code":"export default {\n  name: 'TimetableList',\n  data() {\n    return {\n      timetables: []\n    };\n  },\n  created() {\n    this.loadTimetables();\n  },\n  methods: {\n    async loadTimetables() {\n      try {\n        const response = await this.$http.get(`${process.env.VUE_APP_API_BASE_URL}/timetables`);\n        this.timetables = response.data;\n      } catch (error) {\n        console.error('Erreur:', error);\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleDateString('fr-FR', {\n        day: '2-digit',\n        month: '2-digit',\n        year: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    },\n    async deleteTimetable(id) {\n      if (confirm('Êtes-vous sûr de vouloir supprimer cet emploi du temps ?')) {\n        try {\n          await this.$http.delete(`${process.env.VUE_APP_API_BASE_URL}/timetables/${id}`);\n          this.loadTimetables();\n        } catch (error) {\n          console.error('Erreur:', error);\n          alert('Erreur lors de la suppression');\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","timetables","created","loadTimetables","methods","response","$http","get","process","env","VUE_APP_API_BASE_URL","error","console","formatDate","dateString","date","Date","toLocaleDateString","day","month","year","hour","minute","deleteTimetable","id","confirm","delete","alert"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\views\\TimetableList.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-5\">\r\n        <h1 class=\"mb-4\"><i class=\"fas fa-calendar-alt me-2\"></i>Liste des Emplois du Temps</h1>\r\n        <div class=\"d-flex justify-content-between mb-4\">\r\n            <router-link to=\"/create\" class=\"btn btn-primary\">\r\n                <i class=\"fas fa-plus me-1\"></i>Créer un nouvel emploi du temps\r\n            </router-link>\r\n            <router-link to=\"/upload\" class=\"btn btn-primary\">\r\n                <i class=\"fas fa-download me-1\"></i>Upload .FET File\r\n            </router-link>\r\n            <router-link to=\"/test\" class=\"btn btn-primary\">\r\n                test\r\n            </router-link>\r\n        </div>\r\n        <div class=\"table-responsive\">\r\n            <table class=\"table table-striped table-hover\">\r\n                <thead class=\"table-dark\">\r\n                    <tr>\r\n                        <th>ID</th>\r\n                        <th>Institution</th>\r\n                        <th>Date de création</th>\r\n                        <th>Actions</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr v-for=\"timetable in timetables\" :key=\"timetable.id\">\r\n                        <td>{{ timetable.id }}</td>\r\n                        <td>{{ timetable.institutionName }}</td>\r\n                        <td>{{ formatDate(timetable.created_at) }}</td>\r\n                        <td>\r\n                            <router-link :to=\"'/show/' + timetable.id\" class=\"btn btn-sm btn-info me-2\">\r\n                                <i class=\"fas fa-eye\"></i> Voir\r\n                            </router-link>\r\n                            <router-link :to=\"'/edit/' + timetable.id\" class=\"btn btn-sm btn-warning me-2\">\r\n                                <i class=\"fas fa-edit\"></i> Modifier\r\n                            </router-link>\r\n                            <button @click=\"deleteTimetable(timetable.id)\" class=\"btn btn-sm btn-danger\">\r\n                                <i class=\"fas fa-trash\"></i> Supprimer\r\n                            </button>\r\n                        </td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: 'TimetableList',\r\n    data() {\r\n        return {\r\n            timetables: []\r\n        }\r\n    },\r\n    created() {\r\n        this.loadTimetables();\r\n    },\r\n    methods: {\r\n        async loadTimetables() {\r\n            try {\r\n                const response = await this.$http.get(`${process.env.VUE_APP_API_BASE_URL}/timetables`);\r\n                this.timetables = response.data;\r\n            } catch (error) {\r\n                console.error('Erreur:', error);\r\n            }\r\n        },\r\n        formatDate(dateString) {\r\n            const date = new Date(dateString);\r\n            return date.toLocaleDateString('fr-FR', {\r\n                day: '2-digit',\r\n                month: '2-digit',\r\n                year: 'numeric',\r\n                hour: '2-digit',\r\n                minute: '2-digit'\r\n            });\r\n        },\r\n        async deleteTimetable(id) {\r\n            if (confirm('Êtes-vous sûr de vouloir supprimer cet emploi du temps ?')) {\r\n                try {\r\n                    await this.$http.delete(`${process.env.VUE_APP_API_BASE_URL}/timetables/${id}`);\r\n                    this.loadTimetables();\r\n                } catch (error) {\r\n                    console.error('Erreur:', error);\r\n                    alert('Erreur lors de la suppression');\r\n                }\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>"],"mappings":"AAgDA,eAAe;EACXA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,UAAU,EAAE;IAChB;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACN,IAAI,CAACC,cAAc,CAAC,CAAC;EACzB,CAAC;EACDC,OAAO,EAAE;IACL,MAAMD,cAAcA,CAAA,EAAG;MACnB,IAAI;QACA,MAAME,QAAO,GAAI,MAAM,IAAI,CAACC,KAAK,CAACC,GAAG,CAAC,GAAGC,OAAO,CAACC,GAAG,CAACC,oBAAoB,aAAa,CAAC;QACvF,IAAI,CAACT,UAAS,GAAII,QAAQ,CAACL,IAAI;MACnC,EAAE,OAAOW,KAAK,EAAE;QACZC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;MACnC;IACJ,CAAC;IACDE,UAAUA,CAACC,UAAU,EAAE;MACnB,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAACF,UAAU,CAAC;MACjC,OAAOC,IAAI,CAACE,kBAAkB,CAAC,OAAO,EAAE;QACpCC,GAAG,EAAE,SAAS;QACdC,KAAK,EAAE,SAAS;QAChBC