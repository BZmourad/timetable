{"ast":null,"code":"export default {\n  props: {\n    constraint: Object,\n    days: Array,\n    periods: Array,\n    teachers: Array\n  }\n};","map":{"version":3,"names":["props","constraint","Object","days","Array","periods","teachers"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\constraints\\TeacherNotAvailableTimes.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"form-group\">\r\n      <label>Enseignant :</label>\r\n      <select class=\"form-control\" v-model=\"constraint.teacher\">\r\n        <option v-for=\"teacher in teachers\" :key=\"teacher.id\" :value=\"teacher.id\">\r\n          {{ teacher.name }}\r\n        </option>\r\n      </select>\r\n    </div>\r\n    \r\n    <div class=\"form-group\">\r\n      <label>Périodes non disponibles :</label>\r\n      <div v-for=\"(period, index) in constraint.unavailablePeriods\" :key=\"index\" class=\"period-row\">\r\n        <select class=\"form-control\" v-model=\"period.day\">\r\n          <option v-for=\"day in days\" :key=\"day\" :value=\"day\">{{ day }}</option>\r\n        </select>\r\n        <select class=\"form-control\" v-model=\"period.hour\">\r\n          <option v-for=\"period in periods\" :key=\"period.name\" :value=\"period.name\">\r\n            {{ period.name }}\r\n          </option>\r\n        </select>\r\n        <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove-period', index)\">×</button>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-secondary\" @click=\"$emit('add-period')\">\r\n        Ajouter une période\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    constraint: Object,\r\n    days: Array,\r\n    periods: Array,\r\n    teachers: Array\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.period-row {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-bottom: 10px;\r\n  align-items: center;\r\n}\r\n</style>"],"mappings":"AAgCA,eAAe;EACbA,KAAK,E