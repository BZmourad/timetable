{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nexport default {\n  name: 'ConstraintsTab',\n  props: {\n    formData: {\n      type: Object,\n      required: true\n    }\n  },\n  data() {\n    return {\n      selectedConstraintType: '',\n      showConstraintModal: false,\n      newConstraint: this.getDefaultConstraint()\n    };\n  },\n  methods: {\n    openAddConstraintModal() {\n      console.log('Opening modal, selectedConstraintType:', this.selectedConstraintType);\n      console.log('Before showConstraintModal:', this.showConstraintModal);\n      this.newConstraint = this.getDefaultConstraint();\n      this.showConstraintModal = true;\n      console.log('After showConstraintModal:', this.showConstraintModal);\n\n      // Pour forcer le re-rendu si nécessaire\n      this.$nextTick(() => {\n        console.log('DOM updated, modal should be visible');\n      });\n    },\n    closeConstraintModal() {\n      this.showConstraintModal = false;\n    },\n    getDefaultConstraint() {\n      switch (this.selectedConstraintType) {\n        case 'ConstraintBreakTimes':\n          return {\n            type: 'ConstraintBreakTimes',\n            day: this.formData.selectedDays[0],\n            hour: this.formData.periods[0]?.name || ''\n          };\n        case 'ConstraintTeacherNotAvailableTimes':\n          return {\n            type: 'ConstraintTeacherNotAvailableTimes',\n            teacher: this.formData.teachers[0]?.id || '',\n            unavailablePeriods: [{\n              day: this.formData.selectedDays[0],\n              hour: this.formData.periods[0]?.name || ''\n            }]\n          };\n        case 'ConstraintTeacherMaxDaysPerWeek':\n          return {\n            type: 'ConstraintTeacherMaxDaysPerWeek',\n            teacher: this.formData.teachers[0]?.id || '',\n            maxDays: 5\n          };\n        case 'ConstraintTeacherMinDaysPerWeek':\n          return {\n            type: 'ConstraintTeacherMinDaysPerWeek',\n            teacher: this.formData.teachers[0]?.id || '',\n            minDays: 1\n          };\n        case 'ConstraintTeacherNoTwoConsecutiveDays':\n          return {\n            type: 'ConstraintTeacherNoTwoConsecutiveDays',\n            teacher: this.formData.teachers[0]?.id || ''\n          };\n        default:\n          return {};\n      }\n    },\n    addUnavailablePeriod() {\n      this.newConstraint.unavailablePeriods.push({\n        day: this.formData.selectedDays[0],\n        hour: this.formData.periods[0]?.name || ''\n      });\n    },\n    removeUnavailablePeriod(index) {\n      this.newConstraint.unavailablePeriods.splice(index, 1);\n    },\n    addConstraint() {\n      // Validation basique\n      if (this.selectedConstraintType === 'ConstraintTeacherNotAvailableTimes' && this.newConstraint.unavailablePeriods.length === 0) {\n        alert('Veuillez ajouter au moins une période non disponible');\n        return;\n      }\n      this.formData.contraintes.push(JSON.parse(JSON.stringify(this.newConstraint)));\n      this.closeConstraintModal();\n    },\n    removeConstraint(index) {\n      this.formData.contraintes.splice(index, 1);\n    },\n    getConstraintTypeName(type) {\n      const names = {\n        'ConstraintBreakTimes': 'Temps de pause',\n        'ConstraintTeacherNotAvailableTimes': 'Enseignant non disponible',\n        'ConstraintTeacherMaxDaysPerWeek': 'Jours max/semaine',\n        'ConstraintTeacherMinDaysPerWeek': 'Jours min/semaine',\n        'ConstraintTeacherNoTwoConsecutiveDays': 'Pas 2 jours consécutifs'\n      };\n      return names[type] || type;\n    },\n    getConstraintDetails(constraint) {\n      switch (constraint.type) {\n        case 'ConstraintBreakTimes':\n          return `Jour: ${constraint.day}, Heure: ${constraint.hour}`;\n        case 'ConstraintTeacherNotAvailableTimes':\n          const teacher = this.formData.teachers.find(t => t.id === constraint.teacher);\n          const teacherName = teacher ? teacher.name : 'Inconnu';\n          const periods = constraint.unavailablePeriods.map(p => `${p.day} ${p.hour}`).join(', ');\n          return `Enseignant: ${teacherName}, Périodes: ${periods}`;\n        case 'ConstraintTeacherMaxDaysPerWeek':\n          const teacherMax = this.formData.teachers.find(t => t.id === constraint.teacher);\n          return `Enseignant: ${teacherMax ? teacherMax.name : 'Inconnu'}, Max jours: ${constraint.maxDays}`;\n        case 'ConstraintTeacherMinDaysPerWeek':\n          const teacherMin = this.formData.teachers.find(t => t.id === constraint.teacher);\n          return `Enseignant: ${teacherMin ? teacherMin.name : 'Inconnu'}, Min jours: ${constraint.minDays}`;\n        case 'ConstraintTeacherNoTwoConsecutiveDays':\n          const teacherNoTwo = this.formData.teachers.find(t => t.id === constraint.teacher);\n          return `Enseignant: ${teacherNoTwo ? teacherNoTwo.name : 'Inconnu'}`;\n        default:\n          return JSON.stringify(constraint);\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","props","formData","type","Object","required","data","selectedConstraintType","showConstraintModal","newConstraint","getDefaultConstraint","methods","openAddConstraintModal","console","log","$nextTick","closeConstraintModal","day","selectedDays","hour","periods","teacher","teachers","id","unavailablePeriods","maxDays","minDays","addUnavailablePeriod","push","removeUnavailablePeriod","index","splice","addConstraint","length","alert","contraintes","JSON","parse","stringify","removeConstraint","getConstraintTypeName","names","getConstraintDetails","constraint","find","t","teacherName","map","p","join","teacherMax","teacherMin","teacherNoTwo"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\ConstraintsTab.vue"],"sourcesContent":["<template>\r\n  <div class=\"constraints-tab\">\r\n    <div class=\"constraint-selection\">\r\n      <select class=\"form-control\" id=\"constraintType\" v-model=\"selectedConstraintType\">\r\n  <option value=\"\" disabled>-- Sélectionnez un type --</option>\r\n  <optgroup label=\"Contraintes temporelles\">\r\n    <option value=\"ConstraintBreakTimes\" style=\"padding-left: 20px\">► Général - Temps de pause</option>\r\n    <option value=\"ConstraintTeacherNotAvailableTimes\" style=\"padding-left: 20px\">► Enseignants - Enseignant non disponible</option>\r\n    <option value=\"ConstraintTeacherMaxDaysPerWeek\" style=\"padding-left: 20px\">► Enseignants - Jours max/semaine</option>\r\n    <option value=\"ConstraintTeacherMinDaysPerWeek\" style=\"padding-left: 20px\">► Enseignants - Jours min/semaine</option>\r\n    <option value=\"ConstraintTeacherNoTwoConsecutiveDays\" style=\"padding-left: 20px\">► Enseignants - Pas 2 jours consécutifs</option>\r\n  </optgroup>\r\n</select>\r\n      <button type=\"button\" class=\"btn btn-primary\" @click=\"openAddConstraintModal\" :disabled=\"!selectedConstraintType\">\r\n        Ajouter\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Modal pour ajouter une contrainte -->\r\n    <div class=\"modal show\" v-if=\"showConstraintModal\">\r\n      <div class=\"modal-content\">\r\n        <span class=\"close\" @click=\"closeConstraintModal\">&times;</span>\r\n        \r\n        <h3 v-if=\"selectedConstraintType === 'ConstraintBreakTimes'\">Ajouter un temps de pause</h3>\r\n        <h3 v-else-if=\"selectedConstraintType === 'ConstraintTeacherNotAvailableTimes'\">Enseignant non disponible</h3>\r\n        <h3 v-else-if=\"selectedConstraintType === 'ConstraintTeacherMaxDaysPerWeek'\">Jours max/semaine (enseignant)</h3>\r\n        <h3 v-else-if=\"selectedConstraintType === 'ConstraintTeacherMinDaysPerWeek'\">Jours min/semaine (enseignant)</h3>\r\n        <h3 v-else-if=\"selectedConstraintType === 'ConstraintTeacherNoTwoConsecutiveDays'\">Pas 2 jours consécutifs</h3>\r\n        \r\n        <!-- Formulaire pour ConstraintBreakTimes -->\r\n        <div v-if=\"selectedConstraintType === 'ConstraintBreakTimes'\">\r\n          <div class=\"form-group\">\r\n            <label>Jour :</label>\r\n            <select class=\"form-control\" v-model=\"newConstraint.day\">\r\n              <option v-for=\"day in formData.selectedDays\" :key=\"day\" :value=\"day\">{{ day }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Heure :</label>\r\n            <select class=\"form-control\" v-model=\"newConstraint.hour\">\r\n              <option v-for=\"period in formData.periods\" :key=\"period.name\" :value=\"period.name\">{{ period.name }}</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Formulaire pour ConstraintTeacherNotAvailableTimes -->\r\n        <div v-else-if=\"selectedConstraintType === 'ConstraintTeacherNotAvailableTimes'\">\r\n          <div class=\"form-group\">\r\n            <label>Enseignant :</label>\r\n            <select class=\"form-control\" v-model=\"newConstraint.teacher\">\r\n              <option v-for=\"teacher in formData.teachers\" :key=\"teacher.id\" :value=\"teacher.id\">{{ teacher.name }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Périodes non disponibles :</label>\r\n            <div v-for=\"(period, index) in newConstraint.unavailablePeriods\" :key=\"index\" class=\"period-row\">\r\n              <select class=\"form-control\" v-model=\"period.day\">\r\n                <option v-for=\"day in formData.selectedDays\" :key=\"day\" :value=\"day\">{{ day }}</option>\r\n              </select>\r\n              <select class=\"form-control\" v-model=\"period.hour\">\r\n                <option v-for=\"p in formData.periods\" :key=\"p.name\" :value=\"p.name\">{{ p.name }}</option>\r\n              </select>\r\n              <button class=\"btn btn-danger\" @click=\"removeUnavailablePeriod(index)\">×</button>\r\n            </div>\r\n            <button class=\"btn btn-secondary\" @click=\"addUnavailablePeriod\">Ajouter une période</button>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Formulaire pour ConstraintTeacherMaxDaysPerWeek -->\r\n        <div v-else-if=\"selectedConstraintType === 'ConstraintTeacherMaxDaysPerWeek'\">\r\n          <div class=\"form-group\">\r\n            <label>Enseignant :</label>\r\n            <select class=\"form-control\" v-model=\"newConstraint.teacher\">\r\n              <option v-for=\"teacher in formData.teachers\" :key=\"teacher.id\" :value=\"teacher.id\">{{ teacher.name }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Nombre maximum de jours par semaine :</label>\r\n            <input type=\"number\" class=\"form-control\" v-model.number=\"newConstraint.maxDays\" min=\"0\">\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Formulaire pour ConstraintTeacherMinDaysPerWeek -->\r\n        <div v-else-if=\"selectedConstraintType === 'ConstraintTeacherMinDaysPerWeek'\">\r\n          <div class=\"form-group\">\r\n            <label>Enseignant :</label>\r\n            <select class=\"form-control\" v-model=\"newConstraint.teacher\">\r\n              <option v-for=\"teacher in formData.teachers\" :key=\"teacher.id\" :value=\"teacher.id\">{{ teacher.name }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"form-group\">\r\n            <label>Nombre minimum de jours par semaine :</label>\r\n            <input type=\"number\" class=\"form-control\" v-model.number=\"newConstraint.minDays\" min=\"0\">\r\n          </div>\r\n        </div>\r\n\r\n        <!-- Formulaire pour ConstraintTeacherNoTwoConsecutiveDays -->\r\n        <div v-else-if=\"selectedConstraintType === 'ConstraintTeacherNoTwoConsecutiveDays'\">\r\n          <div class=\"form-group\">\r\n            <label>Enseignant :</label>\r\n            <select class=\"form-control\" v-model=\"newConstraint.teacher\">\r\n              <option v-for=\"teacher in formData.teachers\" :key=\"teacher.id\" :value=\"teacher.id\">{{ teacher.name }}</option>\r\n            </select>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"modal-footer\">\r\n          <button class=\"btn btn-secondary\" @click=\"closeConstraintModal\">Annuler</button>\r\n          <button class=\"btn btn-primary\" @click=\"addConstraint\">Valider</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Tableau des contraintes existantes -->\r\n    <div class=\"constraints-table\" v-if=\"formData.contraintes.length > 0\">\r\n      <h3>Contraintes définies</h3>\r\n      <table class=\"table\">\r\n        <thead>\r\n          <tr>\r\n            <th>Type</th>\r\n            <th>Détails</th>\r\n            <th>Action</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"(constraint, index) in formData.contraintes\" :key=\"index\">\r\n            <td>{{ getConstraintTypeName(constraint.type) }}</td>\r\n            <td>{{ getConstraintDetails(constraint) }}</td>\r\n            <td>\r\n              <button class=\"btn btn-danger\" @click=\"removeConstraint(index)\">Supprimer</button>\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ConstraintsTab',\r\n  props: {\r\n    formData: {\r\n      type: Object,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      selectedConstraintType: '',\r\n      showConstraintModal: false,\r\n      newConstraint: this.getDefaultConstraint()\r\n    }\r\n  },\r\n  methods: {\r\n    openAddConstraintModal() {\r\n        console.log('Opening modal, selectedConstraintType:', this.selectedConstraintType);\r\n        console.log('Before showConstraintModal:', this.showConstraintModal);\r\n        this.newConstraint = this.getDefaultConstraint();\r\n        this.showConstraintModal = true;\r\n        console.log('After showConstraintModal:', this.showConstraintModal);\r\n        \r\n        // Pour forcer le re-rendu si nécessaire\r\n        this.$nextTick(() => {\r\n        console.log('DOM updated, modal should be visible');\r\n        });\r\n    },\r\n    closeConstraintModal() {\r\n      this.showConstraintModal = false;\r\n    },\r\n    getDefaultConstraint() {\r\n      switch(this.selectedConstraintType) {\r\n        case 'ConstraintBreakTimes':\r\n          return {\r\n            type: 'ConstraintBreakTimes',\r\n            day: this.formData.selectedDays[0],\r\n            hour: this.formData.periods[0]?.name || ''\r\n          };\r\n        case 'ConstraintTeacherNotAvailableTimes':\r\n          return {\r\n            type: 'ConstraintTeacherNotAvailableTimes',\r\n            teacher: this.formData.teachers[0]?.id || '',\r\n            unavailablePeriods: [{\r\n              day: this.formData.selectedDays[0],\r\n              hour: this.formData.periods[0]?.name || ''\r\n            }]\r\n          };\r\n        case 'ConstraintTeacherMaxDaysPerWeek':\r\n          return {\r\n            type: 'ConstraintTeacherMaxDaysPerWeek',\r\n            teacher: this.formData.teachers[0]?.id || '',\r\n            maxDays: 5\r\n          };\r\n        case 'ConstraintTeacherMinDaysPerWeek':\r\n          return {\r\n            type: 'ConstraintTeacherMinDaysPerWeek',\r\n            teacher: this.formData.teachers[0]?.id || '',\r\n            minDays: 1\r\n          };\r\n        case 'ConstraintTeacherNoTwoConsecutiveDays':\r\n          return {\r\n            type: 'ConstraintTeacherNoTwoConsecutiveDays',\r\n            teacher: this.formData.teachers[0]?.id || ''\r\n          };\r\n        default:\r\n          return {};\r\n      }\r\n    },\r\n    addUnavailablePeriod() {\r\n      this.newConstraint.unavailablePeriods.push({\r\n        day: this.formData.selectedDays[0],\r\n        hour: this.formData.periods[0]?.name || ''\r\n      });\r\n    },\r\n    removeUnavailablePeriod(index) {\r\n      this.newConstraint.unavailablePeriods.splice(index, 1);\r\n    },\r\n    addConstraint() {\r\n      // Validation basique\r\n      if (this.selectedConstraintType === 'ConstraintTeacherNotAvailableTimes' && \r\n          this.newConstraint.unavailablePeriods.length === 0) {\r\n        alert('Veuillez ajouter au moins une période non disponible');\r\n        return;\r\n      }\r\n\r\n      this.formData.contraintes.push(JSON.parse(JSON.stringify(this.newConstraint)));\r\n      this.closeConstraintModal();\r\n    },\r\n    removeConstraint(index) {\r\n      this.formData.contraintes.splice(index, 1);\r\n    },\r\n    getConstraintTypeName(type) {\r\n      const names = {\r\n        'ConstraintBreakTimes': 'Temps de pause',\r\n        'ConstraintTeacherNotAvailableTimes': 'Enseignant non disponible',\r\n        'ConstraintTeacherMaxDaysPerWeek': 'Jours max/semaine',\r\n        'ConstraintTeacherMinDaysPerWeek': 'Jours min/semaine',\r\n        'ConstraintTeacherNoTwoConsecutiveDays': 'Pas 2 jours consécutifs'\r\n      };\r\n      return names[type] || type;\r\n    },\r\n    getConstraintDetails(constraint) {\r\n      switch(constraint.type) {\r\n        case 'ConstraintBreakTimes':\r\n          return `Jour: ${constraint.day}, Heure: ${constraint.hour}`;\r\n        case 'ConstraintTeacherNotAvailableTimes':\r\n          const teacher = this.formData.teachers.find(t => t.id === constraint.teacher);\r\n          const teacherName = teacher ? teacher.name : 'Inconnu';\r\n          const periods = constraint.unavailablePeriods.map(p => `${p.day} ${p.hour}`).join(', ');\r\n          return `Enseignant: ${teacherName}, Périodes: ${periods}`;\r\n        case 'ConstraintTeacherMaxDaysPerWeek':\r\n          const teacherMax = this.formData.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherMax ? teacherMax.name : 'Inconnu'}, Max jours: ${constraint.maxDays}`;\r\n        case 'ConstraintTeacherMinDaysPerWeek':\r\n          const teacherMin = this.formData.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherMin ? teacherMin.name : 'Inconnu'}, Min jours: ${constraint.minDays}`;\r\n        case 'ConstraintTeacherNoTwoConsecutiveDays':\r\n          const teacherNoTwo = this.formData.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherNoTwo ? teacherNoTwo.name : 'Inconnu'}`;\r\n        default:\r\n          return JSON.stringify(constraint);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.constraints-tab {\r\n  padding: 20px;\r\n}\r\n\r\n.constraint-selection {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.modal {\r\n  position: fixed;\r\n  z-index: 1;\r\n  left: 0;\r\n  top: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0,0,0,0.4);\r\n}\r\n\r\n.modal-content {\r\n  background-color: #fefefe;\r\n  margin: 10% auto;\r\n  padding: 20px;\r\n  border: 1px solid #888;\r\n  width: 50%;\r\n  border-radius: 5px;\r\n}\r\n\r\n.close {\r\n  color: #aaa;\r\n  float: right;\r\n  font-size: 28px;\r\n  font-weight: bold;\r\n  cursor: pointer;\r\n}\r\n\r\n.close:hover {\r\n  color: black;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.period-row {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-bottom: 10px;\r\n  align-items: center;\r\n}\r\n\r\n.modal-footer {\r\n  display: flex;\r\n  justify-content: flex-end;\r\n  gap: 10px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.constraints-table {\r\n  margin-top: 30px;\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.table th, .table td {\r\n  border: 1px solid #ddd;\r\n  padding: 8px;\r\n  text-align: left;\r\n}\r\n\r\n.table th {\r\n  background-color: #f2f2f2;\r\n}\r\n</style>"],"mappings":";;;;AA2IA,eAAe;EACbA,IAAI,EAAE,gBAAgB;EACtBC,KAAK,EAAE;IACLC,Q