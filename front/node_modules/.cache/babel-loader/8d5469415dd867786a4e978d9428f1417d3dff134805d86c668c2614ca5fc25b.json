ctedTimeSlots.splice(index, 1);\r\n        },\r\n        addDuration(index) {\r\n            this.formData.ConstraintStudentsSetMaxSingleGapsInSelectedTimeSlots[index].Selected_Time_Slot.push({\r\n                Day: '',\r\n                Hour: ''\r\n            });\r\n        },\r\n        removeDuration(index, i) {\r\n            if (this.formData.ConstraintStudentsSetMaxSingleGapsInSelectedTimeSlots[index].Selected_Time_Slot.length > 1) {\r\n                this.formData.ConstraintStudentsSetMaxSingleGapsInSelectedTimeSlots[index].Selected_Time_Slot.splice(i, 1);\r\n            } else {\r\n                toastr.warning(\"Vous devez avoir au moins une péride.\");\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n    .item1{\r\n        border: 1px solid #dee2e6;\r\n        border-radius: 0.25rem;\r\n        background-color: #f8f9fa;\r\n    }\r\n</style>"],"mappings":";AAqDA,OAAOA,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,uDAAuD;EAC7DC,KAAK,EAAE;IACHC,QAAQ,EAAE;MACNC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACNP,MAAM,CAACQ,OAAM,GAAI;MACbC,WAAW,EAAE,IAAI;MACjBC,WAAW,EAAE,IAAI;MACjBC,aAAa,EAAE,iBAAiB;MAChCC,OAAO,EAAE;IACb,CAAC;EACL,CAAC;EACDC,OAAO,EAAE;IACLC,aAAaA,CAAA,EAAG;MACZ,IAAI,CAACX,QAAQ,CAACY,qDAAqD,CAACC,IAAI,CAAC;QACrEC,QAAQ,EAAE,EAAE;QACZC,eAAe,EAAE,CAAC;QAClBC,kBAAkB,EAAE,CAAC;UAACC,GAAG,EAAE,EAAE;UAAEC,IAAI,EAAE;QAAE,CAAC;MAC5C,CAAC,CAAC;IACN,CAAC;IACDC,gBAAgBA,CAACC,KAAK,EAAE;MACpB,IAAI,CAACpB,QAAQ,CAACY,qDAAqD,CAACS,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IACxF,CAAC;IACDE,WAAWA,CAACF,KAAK,EAAE;MACf,IAAI,CAACpB,QAAQ,CAACY,qDAAqD,CAACQ,KAAK,CAAC,CAACJ,kBAAkB,CAACH,IAAI,CAAC;QAC/FI,GAAG,EAAE,EAAE;QACPC,IAAI,EAAE;MACV,CAAC,CAAC;IACN,CAAC;IACDK,cAAcA,CAACH,KAAK,EAAEI,CAAC,EAAE;MACrB,IAAI,IAAI,CAACxB,QAAQ,CAACY,qDAAqD,CAACQ,KAAK,CAAC,CAACJ,kBAAkB,CAACS,MAAK,GAAI,CAAC,EAAE;QAC1G,IAAI,CAACzB,QAAQ,CAACY,qDAAqD,CAACQ,KAAK,CAAC,CAACJ,kBAAkB,CAACK,MAAM,CAACG,CAAC,EAAE,CAAC,CAAC;MAC9G,OAAO;QACH3B,MAAM,CAAC6B,OA