{"ast":null,"code":"export default {\n  name: 'TimetableList',\n  data() {\n    return {\n      timetables: [],\n      loading: true,\n      showCopyModal: false,\n      copyLoading: false,\n      copyForm: {\n        id: '',\n        institutionName: ''\n      }\n    };\n  },\n  created() {\n    this.loadTimetables();\n  },\n  methods: {\n    async loadTimetables() {\n      this.loading = true;\n      try {\n        const response = await this.$http.get(`${process.env.VUE_APP_API_BASE_URL}/timetables`);\n        this.timetables = response.data;\n        this.loading = false;\n      } catch (error) {\n        console.error('Erreur:', error);\n        this.loading = false;\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleDateString('fr-FR', {\n        day: '2-digit',\n        month: '2-digit',\n        year: 'numeric',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    },\n    async deleteTimetable(id) {\n      if (confirm('Êtes-vous sûr de vouloir supprimer cet emploi du temps ?')) {\n        try {\n          await this.$http.delete(`${process.env.VUE_APP_API_BASE_URL}/timetables/${id}`);\n          this.loadTimetables();\n        } catch (error) {\n          console.error('Erreur:', error);\n          alert('Erreur lors de la suppression');\n        }\n      }\n    },\n    openCopyTimetableModal(id, institutionName) {\n      this.copyForm.id = id;\n      this.copyForm.institutionName = institutionName + ' - Copie';\n      this.showCopyModal = true;\n    },\n    closeCopyModal() {\n      this.showCopyModal = false;\n      this.copyForm.id = '';\n      this.copyForm.institutionName = '';\n      this.copyLoading = false;\n    },\n    async submitCopyForm() {\n      if (!this.copyForm.institutionName.trim()) {\n        alert('Le nom de l\\'institution est obligatoire');\n        return;\n      }\n      this.copyLoading = true;\n      try {\n        const response = await this.$http.post(`${process.env.VUE_APP_API_BASE_URL}/timetables/copy`, this.copyForm);\n        // Fermer le modal\n        this.closeCopyModal();\n        // Afficher un message de succès\n        alert('Emploi du temps dupliqué avec succès!');\n        // Rafraîchir la liste\n        this.loadTimetables();\n      } catch (error) {\n        console.error('Erreur lors de la duplication:', error);\n        alert('Erreur lors de la duplication: ' + (error.response?.data?.error || error.message || 'Une erreur est survenue'));\n      } finally {\n        this.copyLoading = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","timetables","loading","showCopyModal","copyLoading","copyForm","id","institutionName","created","loadTimetables","methods","response","$http","get","process","env","VUE_APP_API_BASE_URL","error","console","formatDate","dateString","date","Date","toLocaleDateString","day","month","year","hour","minute","deleteTimetable","confirm","delete","alert","openCopyTimetableModal","closeCopyModal","submitCopyForm","trim","post","message"],"sources":["C:\\laragon\\www\\apps\\timetable\\front\\src\\views\\TimetableList.vue"],"sourcesContent":["<template>\r\n    <div v-if=\"loading\" class=\"loading-overlay\">\r\n        <div class=\"spinner-border text-primary\" role=\"status\">\r\n            <span class=\"visually-hidden\">Loading...</span>\r\n        </div>\r\n        <p class=\"mt-2\">Chargement des données...</p>\r\n    </div>\r\n    <div class=\"container mt-5\">\r\n        <h1 class=\"mb-4\"><i class=\"fas fa-calendar-alt me-2\"></i>Liste des Emplois du Temps</h1>\r\n        <div class=\"d-flex justify-content-between mb-4\">\r\n            <router-link to=\"/create\" class=\"btn btn-primary\">\r\n                <i class=\"fas fa-plus me-1\"></i>Créer un nouvel emploi du temps\r\n            </router-link>\r\n            <!--<router-link to=\"/upload\" class=\"btn btn-primary\">\r\n                <i class=\"fas fa-download me-1\"></i>Upload .FET File\r\n            </router-link>\r\n            <router-link to=\"/test\" class=\"btn btn-primary\">\r\n                test\r\n            </router-link>-->\r\n        </div>\r\n        <div class=\"table-responsive\">\r\n            <table class=\"table table-striped table-hover\">\r\n                <thead class=\"table-dark\">\r\n                    <tr>\r\n                        <th>ID</th>\r\n                        <th>Institution</th>\r\n                        <th>Date de création</th>\r\n                        <th>Actions</th>\r\n                    </tr>\r\n                </thead>\r\n                <tbody>\r\n                    <tr v-for=\"timetable in timetables\" :key=\"timetable.id\">\r\n                        <td>{{ timetable.id }}</td>\r\n                        <td>{{ timetable.institutionName }}</td>\r\n                        <td>{{ formatDate(timetable.created_at) }}</td>\r\n                        <td>\r\n                            <router-link :to=\"'/show/' + timetable.id\" class=\"btn btn-sm btn-warning me-2\">\r\n                                <i class=\"fas fa-eye\"></i> Voir\r\n                            </router-link>\r\n                            <router-link :to=\"'/edit/' + timetable.id\" class=\"btn btn-sm btn-info me-2\">\r\n                                <i class=\"fas fa-edit\"></i> Modifier\r\n                            </router-link>\r\n                            <button @click=\"deleteTimetable(timetable.id)\" class=\"btn btn-sm btn-danger me-2\">\r\n                                <i class=\"fas fa-trash\"></i> Supprimer\r\n                            </button>\r\n                            <button class=\"btn btn-sm btn-success\" @click=\"openCopyTimetableModal(timetable.id, timetable.institutionName)\">\r\n                                <i class=\"fas fa-copy\"></i> Dupliquer\r\n                            </button>\r\n                        </td>\r\n                    </tr>\r\n                </tbody>\r\n            </table>\r\n        </div>\r\n    </div>\r\n    <div v-if=\"showCopyModal\" class=\"modal fade show\" style=\"display: block; background-color: rgba(0,0,0,0.5)\">\r\n        <div class=\"modal-dialog\">\r\n            <div class=\"modal-content\">\r\n                <div class=\"modal-header\">\r\n                    <h5 class=\"modal-title\">Dupliquer l'emploi du temps</h5>\r\n                    <button type=\"button\" class=\"btn-close\" @click=\"closeCopyModal\"></button>\r\n                </div>\r\n                <form @submit.prevent=\"submitCopyForm\">\r\n                    <div class=\"modal-body\">\r\n                        <div class=\"mb-3\">\r\n                            <label for=\"institutionName\" class=\"form-label\">Nom de l'institution *</label>\r\n                            <input type=\"text\" class=\"form-control\" id=\"institutionName\" v-model=\"copyForm.institutionName\" required >\r\n                        </div>\r\n                        <input type=\"hidden\" v-model=\"copyForm.id\">\r\n                    </div>\r\n                    <div class=\"modal-footer\">\r\n                        <button type=\"button\" class=\"btn btn-secondary\" @click=\"closeCopyModal\">Annuler</button>\r\n                        <button type=\"submit\" class=\"btn btn-primary\" :disabled=\"loading\">\r\n                            <span v-if=\"loading\" class=\"spinner-border spinner-border-sm me-2\"></span>\r\n                            {{ loading ? 'Duplication...' : 'Dupliquer' }}\r\n                        </button>\r\n                    </div>\r\n                </form>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: 'TimetableList',\r\n    data() {\r\n        return {\r\n            timetables: [],\r\n            loading: true,\r\n            showCopyModal: false,\r\n            copyLoading: false,\r\n            copyForm: {\r\n                id: '',\r\n                institutionName: ''\r\n            }\r\n        }\r\n    },\r\n    created() {\r\n        this.loadTimetables();\r\n    },\r\n    methods: {\r\n        async loadTimetables() {\r\n            this.loading = true;\r\n            try {\r\n                const response = await this.$http.get(`${process.env.VUE_APP_API_BASE_URL}/timetables`);\r\n                this.timetables = response.data;\r\n                this.loading = false;\r\n            } catch (error) {\r\n                console.error('Erreur:', error);\r\n                this.loading = false;\r\n            }\r\n        },\r\n        formatDate(dateString) {\r\n            const date = new Date(dateString);\r\n            return date.toLocaleDateString('fr-FR', {\r\n                day: '2-digit',\r\n                month: '2-digit',\r\n                year: 'numeric',\r\n                hour: '2-digit',\r\n                minute: '2-digit'\r\n            });\r\n        },\r\n        async deleteTimetable(id) {\r\n            if (confirm('Êtes-vous sûr de vouloir supprimer cet emploi du temps ?')) {\r\n                try {\r\n                    await this.$http.delete(`${process.env.VUE_APP_API_BASE_URL}/timetables/${id}`);\r\n                    this.loadTimetables();\r\n                } catch (error) {\r\n                    console.error('Erreur:', error);\r\n                    alert('Erreur lors de la suppression');\r\n                }\r\n            }\r\n        },\r\n        openCopyTimetableModal(id, institutionName) {\r\n            this.copyForm.id = id;\r\n            this.copyForm.institutionName = institutionName + ' - Copie';\r\n            this.showCopyModal = true;\r\n        },\r\n        closeCopyModal() {\r\n            this.showCopyModal = false;\r\n            this.copyForm.id = '';\r\n            this.copyForm.institutionName = '';\r\n            this.copyLoading = false;\r\n        },\r\n        async submitCopyForm() {\r\n            if (!this.copyForm.institutionName.trim()) {\r\n                alert('Le nom de l\\'institution est obligatoire');\r\n                return;\r\n            }\r\n            this.copyLoading = true;\r\n            try {\r\n                const response = await this.$http.post(\r\n                    `${process.env.VUE_APP_API_BASE_URL}/timetables/copy`,\r\n                    this.copyForm\r\n                );\r\n                // Fermer le modal\r\n                this.closeCopyModal();\r\n                // Afficher un message de succès\r\n                alert('Emploi du temps dupliqué avec succès!');\r\n                // Rafraîchir la liste\r\n                this.loadTimetables();\r\n            } catch (error) {\r\n                console.error('Erreur lors de la duplication:', error);\r\n                alert('Erreur lors de la duplication: ' + \r\n                    (error.response?.data?.error || error.message || 'Une erreur est survenue'));\r\n            } finally {\r\n                this.copyLoading = false;\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n    .loading-overlay {\r\n        position: fixed;\r\n        top: 0;\r\n        left: 0;\r\n        right: 0;\r\n        bottom: 0;\r\n        background-color: rgba(255, 255, 255, 0.8);\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: center;\r\n        align-items: center;\r\n        z-index: 1000;\r\n    }\r\n    .loading-overlay p {\r\n        margin-top: 1rem;\r\n        font-size: 1.2rem;\r\n        color: #333;\r\n    }\r\n</style>"],"mappings":"AAmFA,eAAe;EACXA,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,UAAU,EAAE,EAAE;MACdC,OAAO,EAAE,IAAI;MACbC,aAAa,EAAE,KAAK;MACpBC,WAAW,EAAE,KAAK;MAClBC,QAAQ,EAAE;QACNC,EAAE,EAAE,EAAE;QACNC,eAAe,EAAE;MACrB;IACJ;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACN,IAAI,CAACC,cAAc,CAAC,CAAC;EACzB,CAAC;EACDC,OAAO,EAAE;IACL,MAAMD,cAAcA,CAAA,EAAG;MACnB,IAAI,CAACP,OAAM,GAAI,IAAI;MACnB,IAAI;QACA,MAAMS,QAAO,GAAI,MAAM,IAAI,CAA