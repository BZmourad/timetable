{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport toastr from 'toastr';\nexport default {\n  name: 'ConstraintActivitiesMinSimultaneousInSelectedTimeSlots',\n  props: {\n    formData: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    toastr.options = {\n      closeButton: true,\n      progressBar: true,\n      positionClass: 'toast-top-right',\n      timeOut: 3000\n    };\n  },\n  methods: {\n    addConstraint() {\n      this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots.push({\n        Min_Number_of_Simultaneous_Activities: 0,\n        Allow_Empty_Slots: false,\n        Activity: [{\n          Activity_Id: null\n        }],\n        Selected_Time_Slot: [{\n          Day: '',\n          Hour: ''\n        }]\n      });\n    },\n    removeConstraint(index) {\n      this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots.splice(index, 1);\n    },\n    addActivity(index) {\n      this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Activity.push({\n        Activity_Id: null\n      });\n    },\n    removeActivity(index, i) {\n      if (this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Activity.length > 1) {\n        this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Activity.splice(i, 1);\n      } else {\n        toastr.warning(\"Vous devez avoir au moins une activité.\");\n      }\n    },\n    addDuration(index) {\n      this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Selected_Time_Slot.push({\n        Day: '',\n        Hour: ''\n      });\n    },\n    removeDuration(index, i) {\n      if (this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Selected_Time_Slot.length > 1) {\n        this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Selected_Time_Slot.splice(i, 1);\n      } else {\n        toastr.warning(\"Vous devez avoir au moins une péride.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["toastr","name","props","formData","type","Object","required","mounted","options","closeButton","progressBar","positionClass","timeOut","methods","addConstraint","ConstraintActivitiesMinSimultaneousInSelectedTimeSlots","push","Min_Number_of_Simultaneous_Activities","Allow_Empty_Slots","Activity","Activity_Id","Selected_Time_Slot","Day","Hour","removeConstraint","index","splice","addActivity","removeActivity","i","length","warning","addDuration","removeDuration"],"sources":["C:\\laragon\\www\\apps\\timetable\\front\\src\\components\\timetable\\contraintes\\temporel\\Activity\\Autres2\\ConstraintActivitiesMinSimultaneousInSelectedTimeSlots.vue"],"sourcesContent":["<template>\r\n    <div class=\"mb-3\">\r\n        <div class=\"row item1 p-1\" v-for=\"(item, index) in formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots\">\r\n            <div class=\"col-5\">\r\n                <label class=\"form-label\">Nombre minimum d'activités simultanées dans chaque créneau horaire sélectionné :</label>\r\n                <input type=\"number\" min=\"0\" class=\"form-control\" v-model=\"item.Min_Number_of_Simultaneous_Activities\">\r\n            </div>\r\n            <div class=\"col-5\">\r\n                <label class=\"form-label\"><input type=\"checkbox\" v-model=\"item.Allow_Empty_Slots\"> Autoriser créneaux vides</label>\r\n            </div>\r\n            <div class=\"col-2 mt-4\">\r\n                <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"removeConstraint(index)\">\r\n                    <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n                </button>\r\n            </div>\r\n            <div class=\"col-12 p-2\">\r\n                <div class=\"mb-1\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-6\" v-for=\"(item2, index2) in item.Activity\">\r\n                            <div class=\"input-group mb-1\">\r\n                                <select class=\"form-select\" v-model=\"item.Activity_Id\" >\r\n                                    <option value=\"\" disabled>Sélectionnez une activité</option>\r\n                                    <option v-for=\"(activity, index) in formData.activities.filter(activity => activity.subject !== '')\" :value=\"index\">{{ index }}-{{ activity.subject }}-{{ activity.student }}-{{ activity.teacher }}-{{ activity.balise }}</option>\r\n                                </select>\r\n                                <button type=\"button\" class=\"btn btn-danger\" @click=\"removeActivity(index, index2)\">\r\n                                    <i class=\"fas fa-trash\"></i>\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addActivity(index)\">\r\n                        <i class=\"fas fa-plus me-1\"></i>Ajouter\r\n                    </button>\r\n                </div>\r\n            </div>\r\n            <div class=\"col-12 p-2\">\r\n                <div class=\"mb-4\">\r\n                    <div class=\"row\" v-for=\"(item2, index2) in item.Selected_Time_Slot\">\r\n                        <div class=\"col-5\">\r\n                            <label class=\"form-label\">Jour :</label>\r\n                            <select class=\"form-control\" v-model=\"item2.Day\">\r\n                                <option v-for=\"day in formData.selectedDays\" :key=\"day\" :value=\"day\">{{ day }}</option>\r\n                            </select>\r\n                        </div>\r\n                        <div class=\"col-5\">\r\n                            <label class=\"form-label\">Heure :</label>\r\n                            <select class=\"form-control\" v-model=\"item2.Hour\">\r\n                                <option v-for=\"period in formData.periods.filter(period => period.name !== '')\" :key=\"period.name\" :value=\"period.name\">{{ period.name }}</option>\r\n                            </select>\r\n                        </div>\r\n                        <div class=\"col-2 mt-4\">\r\n                            <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"removeDuration(index, index2)\">\r\n                                <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                    <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addDuration(index)\">\r\n                        <i class=\"fas fa-plus me-1\"></i>Ajouter une période\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addConstraint\">\r\n            <i class=\"fas fa-plus me-1\"></i>Ajouter\r\n        </button>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport toastr from 'toastr';\r\n\r\nexport default {\r\n    name: 'ConstraintActivitiesMinSimultaneousInSelectedTimeSlots',\r\n    props: {\r\n        formData: {\r\n            type: Object,\r\n            required: true\r\n        }\r\n    },\r\n    mounted() {\r\n        toastr.options = {\r\n            closeButton: true,\r\n            progressBar: true,\r\n            positionClass: 'toast-top-right',\r\n            timeOut: 3000\r\n        };\r\n    },\r\n    methods: {\r\n        addConstraint() {\r\n            this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots.push({\r\n                Min_Number_of_Simultaneous_Activities: 0,\r\n                Allow_Empty_Slots: false,\r\n                Activity: [{Activity_Id: null}],\r\n                Selected_Time_Slot: [{Day: '', Hour: ''}]\r\n            });\r\n        },\r\n        removeConstraint(index) {\r\n            this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots.splice(index, 1);\r\n        },\r\n        addActivity(index) {\r\n            this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Activity.push({\r\n                Activity_Id: null\r\n            });\r\n        },\r\n        removeActivity(index, i) {\r\n            if (this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Activity.length > 1) {\r\n                this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Activity.splice(i, 1);\r\n            } else {\r\n                toastr.warning(\"Vous devez avoir au moins une activité.\");\r\n            }\r\n        },\r\n        addDuration(index) {\r\n            this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Selected_Time_Slot.push({\r\n                Day: '',\r\n                Hour: ''\r\n            });\r\n        },\r\n        removeDuration(index, i) {\r\n            if (this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Selected_Time_Slot.length > 1) {\r\n                this.formData.ConstraintActivitiesMinSimultaneousInSelectedTimeSlots[index].Selected_Time_Slot.splice(i, 1);\r\n            } else {\r\n                toastr.warning(\"Vous devez avoir au moins une péride.\");\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n    .item1{\r\n        border: 1px solid #dee2e6;\r\n        border-radius: 0.25rem;\r\n        background-color: #f8f9fa;\r\n    }\r\n</style>"],"mappings":";AAqEA,OAAOA,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,wDAAwD;EAC9DC,KAAK,EAAE;IACHC,QAAQ,EAAE;MACNC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACNP,MAAM,CAACQ,OAAM,GAAI;MACbC,WAAW,EAAE,IAAI;MACjBC,WAAW,EAAE,IAAI;MACjBC,aAAa,EAAE,iBAAiB;MAChCC,OAAO,EAAE;IACb,CAAC;EACL,CAAC;EACDC,OAAO,EAAE;IACLC,aAAaA,CAAA,EAAG;MACZ,IAAI,CAACX,QAAQ,CAACY,sDAAsD,CAACC,IAAI,CAAC;QACtEC,qCAAqC,EAAE,CAAC;QACxCC,iBAAiB,EAAE,KAAK;QACxBC,QAAQ,EAAE,CAA