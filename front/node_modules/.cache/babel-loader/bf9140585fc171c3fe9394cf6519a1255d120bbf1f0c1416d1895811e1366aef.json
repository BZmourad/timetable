{"ast":null,"code":"export default {\n  name: 'TeachersTab',\n  props: {\n    teachers: Array,\n    subjects: Array,\n    errors: Object\n  },\n  mounted() {\n    this.$nextTick(() => {\n      $('.qualified-subjects-select').select2({\n        placeholder: \"Sélectionnez des matières\",\n        allowClear: true\n      });\n    });\n  }\n};","map":{"version":3,"names":["name","props","teachers","Array","subjects","errors","Object","mounted","$nextTick","$","select2","placeholder","allowClear"],"sources":["C:\\laragon\\www\\front\\src\\components\\timetable\\TeachersTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Enseignants:</label>\r\n    <div class=\"teachers-container\">\r\n      <div class=\"teacher-item mb-3\" v-for=\"(teacher, index) in teachers\" :key=\"'teacher-'+index\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'teacher-name-' + index\" class=\"form-label\">Nom:</label>\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" \r\n                   :id=\"'teacher-name-' + index\" v-model=\"teacher.name\">\r\n          </div>\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'teacher-code-' + index\" class=\"form-label\">Code:</label>\r\n            <input type=\"text\" class=\"form-control\" :id=\"'teacher-code-' + index\" v-model=\"teacher.code\">\r\n          </div>\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'teacher-longname-' + index\" class=\"form-label\">Nom complet:</label>\r\n            <input type=\"text\" class=\"form-control\" :id=\"'teacher-longname-' + index\" v-model=\"teacher.longName\">\r\n          </div>\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-md-6 mb-3\">\r\n            <label :for=\"'teacher-hours-' + index\" class=\"form-label\">Nombre d'heures cible:</label>\r\n            <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'teacher-hours-' + index\" v-model=\"teacher.targetHours\">\r\n          </div>\r\n        </div>\r\n        <div class=\"mb-3\">\r\n          <label :for=\"'teacher-subjects-' + index\" class=\"form-label\">Matières qualifiées:</label>\r\n          <select class=\"form-select qualified-subjects-select\" multiple :id=\"'teacher-subjects-' + index\" \r\n                  v-model=\"teacher.qualifiedSubjects\" @change=\"$emit('update-qualified-subjects', index, $event)\">\r\n            <option v-for=\"subject in subjects\" :value=\"subject.name\">{{ subject.name }}</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"mb-3\">\r\n          <label :for=\"'teacher-comments-' + index\" class=\"form-label\">Commentaires:</label>\r\n          <textarea class=\"form-control\" :id=\"'teacher-comments-' + index\" \r\n                    v-model=\"teacher.comments\" rows=\"2\"></textarea>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"$emit('remove-teacher', index)\">\r\n          <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n        </button>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-teacher')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter un enseignant\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'TeachersTab',\r\n  props: {\r\n    teachers: Array,\r\n    subjects: Array,\r\n    errors: Object\r\n  },\r\n  mounted() {\r\n    this.$nextTick(() => {\r\n      $('.qualified-subjects-select').select2({\r\n        placeholder: \"Sélectionnez des matières\",\r\n        allowClear: true\r\n      });\r\n    });\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAkDA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,QAAQ,EAAEC,KAAK;IACfC,QAAQ,EAAED,KAAK;IACfE,MAAM,EAAEC;EACV,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,SAAS,CAAC,MAAM;MACnBC,CAAC,CAAC,4BAA4B,CAAC,CAACC,O