{"ast":null,"code":"import Select2 from '@/components/Select2.vue';\nexport default {\n  name: 'TeachersTab',\n  props: {\n    teachers: Array,\n    subjects: Array,\n    errors: Object\n  },\n  components: {\n    Select2\n  }\n};","map":{"version":3,"names":["Select2","name","props","teachers","Array","subjects","errors","Object","components"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\TeachersTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Enseignants:</label>\r\n    <div class=\"teachers-container\">\r\n      <div class=\"row\" v-for=\"(teacher, index) in teachers\" :key=\"'teacher-'+index\">\r\n        <div class=\"input-group mb-3\">\r\n          <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" :id=\"'teacher-name-' + index\" v-model=\"teacher.name\" placeholder=\"Nom\">\r\n          <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'teacher-hours-' + index\" v-model=\"teacher.targetHours\" placeholder=\"Nombre d'heures cible\">\r\n          <Select2 v-model=\"teacher.qualifiedSubjects\" :options=\"subjects.filter(subject => subject.name !== '')\" :multiple=\"true\" />\r\n          <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove-teacher', index)\">\r\n              <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n            </button>\r\n        </div>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-teacher')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter un enseignant\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport Select2 from '@/components/Select2.vue';\r\n\r\nexport default {\r\n    name: 'TeachersTab',\r\n    props: {\r\n        teachers: Array,\r\n        subjects: Array,\r\n        errors: Object\r\n    },\r\n    components: {\r\n        Select2\r\n    },\r\n}\r\n</script>\r\n"],"mappings":"AAsBA,OAAOA,OAAM,MAAO,0B