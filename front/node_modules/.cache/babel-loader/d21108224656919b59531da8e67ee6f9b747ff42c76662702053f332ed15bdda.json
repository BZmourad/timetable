traintSubjectPreferredRooms[index].Preferred_Room.splice(i, 1);\r\n            } else {\r\n                toastr.warning(\"Vous devez avoir au moins une salle.\");\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n    .item1{\r\n        border: 1px solid #dee2e6;\r\n        border-radius: 0.25rem;\r\n        background-color: #f8f9fa;\r\n    }\r\n</style>"],"mappings":";AAqDA,OAAOA,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,iCAAiC;EACvCC,KAAK,EAAE;IACHC,QAAQ,EAAE;MACNC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACNP,MAAM,CAACQ,OAAM,GAAI;MACbC,WAAW,EAAE,IAAI;MACjBC,WAAW,EAAE,IAAI;MACjBC,aAAa,EAAE,iBAAiB;MAChCC,OAAO,EAAE;IACb,CAAC;EACL,CAAC;EACDC,OAAO,EAAE;IACLC,aAAaA,CAAA,EAAG;MACZ,IAAI,CAACX,QAAQ,CAACY,+BAA+B,CAACC,IAAI,CAAC;QAC/CC,OAAO,EAAE,EAAE;QACXC,cAAc,EAAE,CAAC;UAACC,IAAI,EAAE;QAAE,CAAC;MAC/B,CAAC,CAAC;IACN,CAAC;IACDC,gBAAgBA,CAACC,KAAK,EAAE;MACpB,IAAI,CAAClB,QAAQ,CAACY,+BAA+B,CAACO,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IAClE,CAAC;IACDE,WAAWA,CAACF,KAAK,EAAE;MACf,IAAI,CAAClB,QAAQ,CAACY,+BAA+B,CAACM,KAAK,CAAC,CAACG,kBAAkB,CAACR,IAAI,CAAC;QACzEG,IAAI,EAAE;MACV,CAAC,CAAC;IACN,CAAC;IACDM,cAAcA,CAACJ,KAAK,EAAEK,CAAC,EAAE;MACrB,IAAI,IAAI,CAACvB,QAAQ,CAACY,+BAA+B,CAACM,KAAK,CAAC,CAACH,cAAc,CAACS,MAAK,GAAI,CAAC,EAAE;QAChF,IAAI,CAACxB,QAAQ,CAACY,+BAA+B,CAACM,KAAK,CAAC,CAACH,cAAc,CAACI,MAAM,CAACI,CAAC,EAAE,CAAC,CAAC;MACpF,OAAO;QACH1B,MAAM,CAAC4B,OAAO,CAAC,sCAAsC,CAAC;MAC1D;IACJ;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}