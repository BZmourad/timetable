,"getTypeName","type","getDetails","onClick","$event","_ctx","$emit","_hoisted_3"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\constraints\\ConstraintsTable.vue"],"sourcesContent":["<template>\r\n  <div class=\"constraints-table\" v-if=\"constraints.length > 0\">\r\n    <h3>Contraintes définies</h3>\r\n    <table class=\"table\">\r\n      <thead>\r\n        <tr>\r\n          <th>Type</th>\r\n          <th>Détails</th>\r\n          <th>Action</th>\r\n        </tr>\r\n      </thead>\r\n      <tbody>\r\n        <tr v-for=\"(constraint, index) in constraints\" :key=\"index\">\r\n          <td>{{ getTypeName(constraint.type) }}</td>\r\n          <td>{{ getDetails(constraint) }}</td>\r\n          <td>\r\n            <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove', index)\">\r\n              Supprimer\r\n            </button>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  props: {\r\n    constraints: Array,\r\n    teachers: Array\r\n  },\r\n  methods: {\r\n    getTypeName(type) {\r\n      const names = {\r\n        'ConstraintBreakTimes': 'Temps de pause',\r\n        'ConstraintTeacherNotAvailableTimes': 'Enseignant non disponible',\r\n        'ConstraintTeacherMaxDaysPerWeek': 'Jours max/semaine',\r\n        'ConstraintTeacherMinDaysPerWeek': 'Jours min/semaine',\r\n        'ConstraintTeacherNoTwoConsecutiveDays': 'Pas 2 jours consécutifs'\r\n      };\r\n      return names[type] || type;\r\n    },\r\n    getDetails(constraint) {\r\n      switch(constraint.type) {\r\n        case 'ConstraintBreakTimes':\r\n          return `Jour: ${constraint.day}, Heure: ${constraint.hour}`;\r\n        case 'ConstraintTeacherNotAvailableTimes':\r\n          const teacher = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacher?.name || 'Inconnu'}, Périodes: ${\r\n            constraint.unavailablePeriods.map(p => `${p.day} ${p.hour}`).join(', ')\r\n          }`;\r\n        case 'ConstraintTeacherMaxDaysPerWeek':\r\n          const teacherMax = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherMax?.name || 'Inconnu'}, Max: ${constraint.maxDays} jours`;\r\n        case 'ConstraintTeacherMinDaysPerWeek':\r\n          const teacherMin = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherMin?.name || 'Inconnu'}, Min: ${constraint.minDays} jours`;\r\n        case 'ConstraintTeacherNoTwoConsecutiveDays':\r\n          const teacherNoTwo = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherNoTwo?.name || 'Inconnu'}`;\r\n        default:\r\n          return JSON.stringify(constraint);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.constraints-table {\r\n  margin-top: 30px;\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.table th, .table td {\r\n  border: 1px solid #ddd;\r\n  padding: 8px;\r\n  text-align: left;\r\n}\r\n\r\n.table th {\r\n  background-color: #f2f2f2;\r\n}\r\n</style>"],"mappings":";;;EACOA,KAAK,EAAC;;;EAEFA,KAAK,EAAC;AAAO;;;SAFeC,MAAA,CAAAC,WAAW,CAACC,MAAM,Q,cAAvDC,mBAAA,CAsBM,OAtBNC,UAsBM,G,0BArBJC,mBAAA,CAA6B,YAAzB,sBAAoB,qBACxBA,mBAAA,CAmBQ,SAnBRC,UAmBQ,G,0BAlBND,mBAAA,CAMQ,gBALNA,mBAAA,CAIK,aAHHA,mBAAA,CAAa,YAAT,MAAI,GACRA,mBAAA,CAAgB,YAAZ,SAAO,GACXA,mBAAA,CAAe,YAAX,QAAM,E,uBAGdA,mBAAA,CAUQ,iB,kBATNF,mBAAA,CAQKI,SAAA,QAAAC,WAAA,CAR6BR,MAAA,CAAAC,WAAW,GAAjCQ,UAAU,EAAEC,KAAK;yBAA7BP,mBAAA,CAQK;MAR2CQ,GAAG,EAAED;IAAK,IACxDL,mBAAA,CAA2C,YAAAO,gBAAA,CAApCC,QAAA,CAAAC,WAAW,CAACL,UAAU,CAACM,IAAI,mBAClCV,mBAAA,CAAqC,YAAAO,gBAAA,CAA9BC,QAAA,CAAAG,UAAU,CAACP,UAAU,mBAC5BJ,mBAAA,CAIK,aAHHA,mBAAA,CAES;MAFDU,IAAI,EAAC,QAAQ;MAAChB,KAAK,EAAC,gBAAgB;MAAEkB,OAAK,EAAAC,MAAA,IAAEC,IAAA,CAAAC,KAAK,WAAWV,KAAK;OAAG,aAE7E,iBAAAW,UAAA,E","ignoreList":[]},"metadata":{},"sourceType":"mod