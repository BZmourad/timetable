{"ast":null,"code":"export default {\n  name: 'TeachersTab',\n  props: {\n    teachers: Array,\n    subjects: Array,\n    errors: Object\n  }\n};","map":{"version":3,"names":["name","props","teachers","Array","subjects","errors","Object"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\TeachersTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Enseignants:</label>\r\n    <div class=\"teachers-container\">\r\n      <div class=\"teacher-item mb-3\" v-for=\"(teacher, index) in teachers\" :key=\"'teacher-'+index\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-3\">\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" :id=\"'teacher-name-' + index\" v-model=\"teacher.name\" placeholder=\"Nom\">\r\n          </div>\r\n          <div class=\"col-md-3\">\r\n            <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'teacher-hours-' + index\" v-model=\"teacher.targetHours\" placeholder=\"Nombre d'heures cible\">\r\n          </div>\r\n          <div class=\"col-md-5\">\r\n            <select class=\"form-select qualified-subjects-select\" placeholder=\"Matières qualifiées\" multiple :id=\"'teacher-subjects-' + index\" v-model=\"teacher.qualifiedSubjects\" @change=\"$emit('update-qualified-subjects', index, $event)\">\r\n              <option v-for=\"subject in subjects.filter(subject => subject.name !== '')\" :value=\"subject.name\">{{ subject.name }}</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"col-md-1 mt-5\">\r\n            <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove-teacher', index)\">\r\n              <i class=\"fas fa-trash me-1\"></i>\r\n            </button>\r\n          </div>\r\n        </div>\r\n        \r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-teacher')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter un enseignant\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: 'TeachersTab',\r\n    props: {\r\n        teachers: Array,\r\n        subjects: Array,\r\n        errors: Object\r\n    }\r\n}\r\n</script>\r\n"],"mappings":"AAiCA,eAAe;EACXA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACHC,QAAQ,EAAEC,KAAK;IACfC,QAAQ,EAAED,KAAK;IACfE,MAAM,EAAEC;EACZ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}