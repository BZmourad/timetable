{"ast":null,"code":"export default {\n  name: 'TeachersTab',\n  props: {\n    teachers: Array,\n    subjects: Array,\n    errors: Object\n  },\n  mounted() {\n    this.initSelect2();\n  },\n  beforeDestroy() {\n    this.destroySelect2();\n  },\n  methods: {\n    isSelected(subjectName) {\n      return this.teacher.qualifiedSubjects.includes(subjectName);\n    },\n    initSelect2() {\n      const selectElement = $(this.$refs[`select2-${this.index}`]);\n      selectElement.select2({\n        placeholder: \"Sélectionnez des matières\",\n        allowClear: true\n      });\n\n      // Mise à jour du modèle Vue quand Select2 change\n      selectElement.on('change', e => {\n        this.$emit('update-qualified-subjects', this.index, {\n          target: {\n            value: selectElement.val()\n          }\n        });\n      });\n    },\n    destroySelect2() {\n      const selectElement = $(this.$refs[`select2-${this.index}`]);\n      selectElement.off('change');\n      selectElement.select2('destroy');\n    }\n  },\n  watch: {\n    'teacher.qualifiedSubjects'(newVal) {\n      // Mise à jour de Select2 quand le modèle Vue change\n      this.$nextTick(() => {\n        const selectElement = $(this.$refs[`select2-${this.index}`]);\n        selectElement.val(newVal).trigger('change');\n      });\n    },\n    filteredSubjects() {\n      // Reinitialiser Select2 quand les sujets changent\n      this.$nextTick(() => {\n        this.destroySelect2();\n        this.initSelect2();\n      });\n    }\n  }\n  /*mounted() {\r\n    this.$nextTick(() => {\r\n      $('.qualified-subjects-select').select2({\r\n        placeholder: \"Sélectionnez des matières\",\r\n        allowClear: true\r\n      });\r\n    });\r\n  }*/\n};","map":{"version":3,"names":["name","props","teachers","Array","subjects","errors","Object","mounted","initSelect2","beforeDestroy","destroySelect2","methods","isSelected","subjectName","teacher","qualifiedSubjects","includes","selectElement","$","$refs","index","select2","placeholder","allowClear","on","e","$emit","target","value","val","off","watch","teacher.qualifiedSubjects","newVal","$nextTick","trigger","filteredSubjects"],"sources":["C:\\laragon\\www\\front\\src\\components\\timetable\\TeachersTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Enseignants:</label>\r\n    <div class=\"teachers-container\">\r\n      <div class=\"teacher-item mb-3\" v-for=\"(teacher, index) in teachers\" :key=\"'teacher-'+index\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'teacher-name-' + index\" class=\"form-label\">Nom:</label>\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" \r\n                   :id=\"'teacher-name-' + index\" v-model=\"teacher.name\">\r\n          </div>\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'teacher-code-' + index\" class=\"form-label\">Code:</label>\r\n            <input type=\"text\" class=\"form-control\" :id=\"'teacher-code-' + index\" v-model=\"teacher.code\">\r\n          </div>\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'teacher-longname-' + index\" class=\"form-label\">Nom complet:</label>\r\n            <input type=\"text\" class=\"form-control\" :id=\"'teacher-longname-' + index\" v-model=\"teacher.longName\">\r\n          </div>\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-md-6 mb-3\">\r\n            <label :for=\"'teacher-hours-' + index\" class=\"form-label\">Nombre d'heures cible:</label>\r\n            <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'teacher-hours-' + index\" v-model=\"teacher.targetHours\">\r\n          </div>\r\n        </div>\r\n        <div class=\"mb-3\">\r\n          <label :for=\"'teacher-subjects-' + index\" class=\"form-label\">Matières qualifiées:</label>\r\n          <select class=\"form-select qualified-subjects-select\" multiple :id=\"'teacher-subjects-' + index\" \r\n                  v-model=\"teacher.qualifiedSubjects\" @change=\"$emit('update-qualified-subjects', index, $event)\">\r\n            <option v-for=\"subject in subjects.filter(subject => subject.name !== '')\" :value=\"subject.name\">{{ subject.name }}</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"mb-3\">\r\n          <label :for=\"'teacher-comments-' + index\" class=\"form-label\">Commentaires:</label>\r\n          <textarea class=\"form-control\" :id=\"'teacher-comments-' + index\" \r\n                    v-model=\"teacher.comments\" rows=\"2\"></textarea>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"$emit('remove-teacher', index)\">\r\n          <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n        </button>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-teacher')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter un enseignant\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'TeachersTab',\r\n  props: {\r\n    teachers: Array,\r\n    subjects: Array,\r\n    errors: Object\r\n  },\r\n  mounted() {\r\n    this.initSelect2();\r\n  },\r\n  beforeDestroy() {\r\n    this.destroySelect2();\r\n  },\r\n  methods: {\r\n    isSelected(subjectName) {\r\n      return this.teacher.qualifiedSubjects.includes(subjectName);\r\n    },\r\n    initSelect2() {\r\n      const selectElement = $(this.$refs[`select2-${this.index}`]);\r\n      \r\n      selectElement.select2({\r\n        placeholder: \"Sélectionnez des matières\",\r\n        allowClear: true\r\n      });\r\n\r\n      // Mise à jour du modèle Vue quand Select2 change\r\n      selectElement.on('change', (e) => {\r\n        this.$emit('update-qualified-subjects', this.index, {\r\n          target: {\r\n            value: selectElement.val()\r\n          }\r\n        });\r\n      });\r\n    },\r\n    destroySelect2() {\r\n      const selectElement = $(this.$refs[`select2-${this.index}`]);\r\n      selectElement.off('change');\r\n      selectElement.select2('destroy');\r\n    }\r\n  },\r\n  watch: {\r\n    'teacher.qualifiedSubjects'(newVal) {\r\n      // Mise à jour de Select2 quand le modèle Vue change\r\n      this.$nextTick(() => {\r\n        const selectElement = $(this.$refs[`select2-${this.index}`]);\r\n        selectElement.val(newVal).trigger('change');\r\n      });\r\n    },\r\n    filteredSubjects() {\r\n      // Reinitialiser Select2 quand les sujets changent\r\n      this.$nextTick(() => {\r\n        this.destroySelect2();\r\n        this.initSelect2();\r\n      });\r\n    }\r\n  }\r\n  /*mounted() {\r\n    this.$nextTick(() => {\r\n      $('.qualified-subjects-select').select2({\r\n        placeholder: \"Sélectionnez des matières\",\r\n        allowClear: true\r\n      });\r\n    });\r\n  }*/\r\n}\r\n</script>\r\n"],"mappings":"AAkDA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,QAAQ,EAAEC,KAAK;IACfC,QAAQ,EAAED,KAAK;IACfE,MAAM,EAAEC;EACV,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,WAAW,CAAC,CAAC;EACpB,CAAC;EACDC,aAAaA,CAAA,EAAG;IACd,IAAI,CAACC,cAAc,CAAC,CAAC;EACvB,CAAC;EACDC,OAAO,EAAE;IACPC,UAAUA,CAACC,WAAW,EAAE;MACtB,OAAO,IAAI,CAACC,OAAO,CAACC,iBAAiB,CAACC,QAAQ,CAACH,WAAW,CAAC;IAC7D,CAAC;IACDL,WAAWA,CAAA,EAAG;MACZ,MAAMS,aAAY,GAAIC,CAAC,CAAC,IAAI,CAACC,KAAK,CAAC,WAAW,IAAI,CAACC,KAAK,EAAE,CAAC,CAAC;MAE5DH,aAAa,CAACI,OAAO,CAAC;QACpBC,WAAW,EAAE,2BAA2B;QACxCC,UAAU,EAAE;MACd,CAAC,CAAC;;MAEF;MACAN,aAAa,CAACO,EAAE,CAAC,QAAQ,EAAGC,CAAC,IAAK;QAChC,IAAI,CAACC,KAAK,CAAC,2BAA2B,EAAE,IAAI,CAACN,KAAK,EAAE;UAClDO,MAAM,EAAE;YACNC,KAAK,EAAEX,aAAa,CAACY,GAAG,CAAC;UAC3B;QACF,CAAC,CAAC;MACJ,CAAC,CAAC;IACJ,CAAC;IACDnB,cAAcA,CAAA,EAAG;MACf,MAAMO,aAAY,GAAIC,CAAC,CAAC,IAAI,CAACC,KAAK,CAAC,WAAW,IAAI,CAACC,KAAK,EAAE,CAAC,CAAC;MAC5DH,aAAa,CAACa,GAAG,CAAC,QAAQ,CAAC;MAC3Bb,aAAa,CAACI,OAAO,CAAC,SAAS,CAAC;IAClC;EACF,CAAC;EACDU,KAAK,EAAE;IACL,2BAA2BC,CAACC,