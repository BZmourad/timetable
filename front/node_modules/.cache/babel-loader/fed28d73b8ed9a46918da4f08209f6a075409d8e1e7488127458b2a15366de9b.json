{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport toastr from 'toastr';\nexport default {\n  name: 'ConstraintMinGapsBetweenActivities',\n  props: {\n    formData: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    toastr.options = {\n      closeButton: true,\n      progressBar: true,\n      positionClass: 'toast-top-right',\n      timeOut: 3000\n    };\n  },\n  methods: {\n    addConstraint() {\n      this.formData.ConstraintMinGapsBetweenActivities.push({\n        MinGaps: 0,\n        Activity: [{\n          Activity_Id: null\n        }]\n      });\n    },\n    removeConstraint(index) {\n      this.formData.ConstraintMinGapsBetweenActivities.splice(index, 1);\n    },\n    addActivity(index) {\n      this.formData.ConstraintMinGapsBetweenActivities[index].Activity.push({\n        Activity_Id: null\n      });\n    },\n    removeActivity(index, i) {\n      if (this.formData.ConstraintMinGapsBetweenActivities[index].Activity.length > 1) {\n        this.formData.ConstraintMinGapsBetweenActivities[index].Activity.splice(i, 1);\n      } else {\n        toastr.warning(\"Vous devez avoir au moins une activité.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["toastr","name","props","formData","type","Object","required","mounted","options","closeButton","progressBar","positionClass","timeOut","methods","addConstraint","ConstraintMinGapsBetweenActivities","push","MinGaps","Activity","Activity_Id","removeConstraint","index","splice","addActivity","removeActivity","i","length","warning"],"sources":["C:\\laragon\\www\\apps\\timetable\\front\\src\\components\\timetable\\contraintes\\temporal\\Activity\\Autres2\\ConstraintMinGapsBetweenActivities.vue"],"sourcesContent":["<template>\r\n    <div class=\"mb-3\">\r\n        <div class=\"row item1 p-1\" v-for=\"(item, index) in formData.ConstraintMinGapsBetweenActivities\">\r\n            <div class=\"col-9\">\r\n                <label class=\"form-label\">Vides minimum :</label>\r\n                <input type=\"number\" min=\"0\" class=\"form-control\" v-model=\"item.MinGaps\">\r\n            </div>\r\n            <div class=\"col-3 mt-4\">\r\n                <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"removeConstraint(index)\">\r\n                    <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n                </button>\r\n            </div>\r\n            <div class=\"col-12 p-2\">\r\n                <div class=\"mb-1\">\r\n                    <div class=\"row\">\r\n                        <div class=\"col-6\" v-for=\"(item2, index2) in item.Activity\">\r\n                            <div class=\"input-group mb-1\">\r\n                                <select class=\"form-select\" v-model=\"item.Activity_Id\" >\r\n                                    <option value=\"\" disabled>Sélectionnez une activité</option>\r\n                                    <option v-for=\"(activity, index) in formData.activities.filter(activity => activity.subject !== '')\" :value=\"index\">{{ index }}-{{ activity.subject }}-{{ activity.student }}-{{ activity.teacher }}-{{ activity.balise }}</option>\r\n                                </select>\r\n                                <button type=\"button\" class=\"btn btn-danger\" @click=\"removeActivity(index, index2)\">\r\n                                    <i class=\"fas fa-trash\"></i>\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addActivity(index)\">\r\n                        <i class=\"fas fa-plus me-1\"></i>Ajouter\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addConstraint\">\r\n            <i class=\"fas fa-plus me-1\"></i>Ajouter\r\n        </button>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport toastr from 'toastr';\r\n\r\nexport default {\r\n    name: 'ConstraintMinGapsBetweenActivities',\r\n    props: {\r\n        formData: {\r\n            type: Object,\r\n            required: true\r\n        }\r\n    },\r\n    mounted() {\r\n        toastr.options = {\r\n            closeButton: true,\r\n            progressBar: true,\r\n            positionClass: 'toast-top-right',\r\n            timeOut: 3000\r\n        };\r\n    },\r\n    methods: {\r\n        addConstraint() {\r\n            this.formData.ConstraintMinGapsBetweenActivities.push({\r\n                MinGaps: 0,\r\n                Activity: [{Activity_Id: null}],\r\n            });\r\n        },\r\n        removeConstraint(index) {\r\n            this.formData.ConstraintMinGapsBetweenActivities.splice(index, 1);\r\n        },\r\n        addActivity(index) {\r\n            this.formData.ConstraintMinGapsBetweenActivities[index].Activity.push({\r\n                Activity_Id: null\r\n            });\r\n        },\r\n        removeActivity(index, i) {\r\n            if (this.formData.ConstraintMinGapsBetweenActivities[index].Activity.length > 1) {\r\n                this.formData.ConstraintMinGapsBetweenActivities[index].Activity.splice(i, 1);\r\n            } else {\r\n                toastr.warning(\"Vous devez avoir au moins une activité.\");\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n    .item1{\r\n        border: 1px solid #dee2e6;\r\n        border-radius: 0.25rem;\r\n        background-color: #f8f9fa;\r\n    }\r\n</style>"],"mappings":";AAwCA,OAAOA,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,oCAAoC;EAC1CC,KAAK,EAAE;IACHC,QAAQ,EAAE;MACNC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACNP,MAAM,CAACQ,OAAM,GAAI;MACbC,WAAW,EAAE,IAAI;MACjBC,WAAW,EAAE,IAAI;MACjBC,aAAa,EAAE,iBAAiB;MAChCC,OAAO,EAAE;IACb,CAAC;EACL,CAAC;EACDC,OAAO,EAAE;IACLC,aAAaA,CAAA,EAAG;MACZ,IAAI,CAACX,QAAQ,CAACY,kCAAkC,CAACC,IAAI,