{"ast":null,"code":"export default {\n  name: 'RoomsTab',\n  props: {\n    rooms: Array,\n    errors: Object\n  }\n};","map":{"version":3,"names":["name","props","rooms","Array","errors","Object"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\RoomsTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Salles:</label>\r\n    <div class=\"rooms-container\">\r\n      <div class=\"row\">\r\n        <div class=\"col-md-6\" v-for=\"(room, index) in rooms\" :key=\"'room-'+index\">\r\n          <div class=\"input-group mb-3\">\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" :id=\"'room-name-' + index\" v-model=\"room.name\" placeholder=\"Nom\">\r\n            <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'room-capacity-' + index\" v-model=\"room.capacity\" placeholder=\"Capacité\">\r\n            <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove-room', index)\">\r\n              <i class=\"fas fa-trash\"></i>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-room')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter une salle\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'RoomsTab',\r\n  props: {\r\n    rooms: Array,\r\n    errors: Object\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAuBA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,KAAK,EAAE;IACLC,KAAK,EAAEC,KAAK;IACZC,MAAM,EAAEC;EACV;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}