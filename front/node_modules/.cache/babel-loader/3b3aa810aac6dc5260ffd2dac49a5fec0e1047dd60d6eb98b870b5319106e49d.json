{"ast":null,"code":"import axios from 'axios';\nimport toastr from 'toastr';\nexport default {\n  name: 'ShowTimetable',\n  props: {\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      timetable: {\n        data: {},\n        created_at: '',\n        xmlData: ''\n      }\n    };\n  },\n  computed: {\n    formattedJson() {\n      return JSON.stringify(this.timetable.data, null, 2);\n    }\n  },\n  created() {\n    this.loadTimetableData();\n  },\n  methods: {\n    async loadTimetableData() {\n      try {\n        const response = await axios.get(`${process.env.VUE_APP_API_BASE_URL}/timetables/${this.id}/show`);\n        this.timetable = response.data;\n      } catch (error) {\n        console.error('Erreur:', error);\n        toastr.error('Erreur lors du chargement des données');\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleString('fr-FR');\n    },\n    async copyXml() {\n      try {\n        await navigator.clipboard.writeText(this.timetable.xmlData);\n        toastr.success('XML copié dans le presse-papier');\n      } catch (error) {\n        console.error('Erreur lors de la copie:', error);\n        toastr.error('Échec de la copie');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","toastr","name","props","id","type","String","required","data","timetable","created_at","xmlData","computed","formattedJson","JSON","stringify","created","loadTimetableData","methods","response","get","process","env","VUE_APP_API_BASE_URL","error","console","formatDate","dateString","date","Date","toLocaleString","copyXml","navigator","clipboard","writeText","success"],"sources":["C:\\laragon\\www\\front\\src\\views\\ShowTimetable.vue"],"sourcesContent":["<template>\r\n    <div class=\"container mt-5\">\r\n        <div class=\"d-flex justify-content-between align-items-center mb-4\">\r\n            <h1><i class=\"fas fa-calendar-alt me-2\"></i>Détails de l'Emploi du Temps</h1>\r\n            <router-link to=\"/\" class=\"btn btn-outline-secondary\">\r\n                <i class=\"fas fa-arrow-left me-1\"></i>Retour\r\n            </router-link>\r\n            <router-link :to=\"'/edit/' + timetable.id\" class=\"btn btn-outline-primary\">\r\n                <i class=\"fas fa-edit me-1\"></i> Modifier\r\n            </router-link>\r\n        </div>\r\n\r\n        <div class=\"card mb-4\">\r\n            <div class=\"card-header bg-primary text-white\">\r\n                <h5 class=\"mb-0\">Informations de base</h5>\r\n            </div>\r\n            <div class=\"card-body\">\r\n                <p v-if=\"timetable.data\"><strong>Institution:</strong> {{ timetable.data.institutionName }}</p>\r\n                <p><strong>Créé le:</strong> {{ formatDate(timetable.created_at) }}</p>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"card mb-4\">\r\n            <div class=\"card-header bg-primary text-white\">\r\n                <h5 class=\"mb-0\">Données complètes (JSON)</h5>\r\n            </div>\r\n            <div class=\"card-body\">\r\n                <pre class=\"p-3 bg-light rounded\">{{ formattedJson }}</pre>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"card mb-4\">\r\n            <div class=\"card-header bg-primary text-white d-flex justify-content-between align-items-center\">\r\n                <h5 class=\"mb-0\">Données au format XML (FET)</h5>\r\n                <button @click=\"copyXml\" class=\"btn btn-sm btn-light\">\r\n                    <i class=\"fas fa-copy\"></i> Copier\r\n                </button>\r\n            </div>\r\n            <div class=\"card-body\">\r\n                <pre class=\"p-3 bg-light rounded\">{{ timetable.xmlData }}</pre>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport toastr from 'toastr';\r\n\r\nexport default {\r\n    name: 'ShowTimetable',\r\n    props: {\r\n        id: {\r\n            type: String,\r\n            required: true\r\n        }\r\n    },\r\n    data() {\r\n        return {\r\n            timetable: {\r\n                data: {},\r\n                created_at: '',\r\n                xmlData: ''\r\n            }\r\n        };\r\n    },\r\n    computed: {\r\n        formattedJson() {\r\n            return JSON.stringify(this.timetable.data, null, 2);\r\n        }\r\n    },\r\n    created() {\r\n        this.loadTimetableData();\r\n    },\r\n    methods: {\r\n        async loadTimetableData() {\r\n            try {\r\n                const response = await axios.get(`${process.env.VUE_APP_API_BASE_URL}/timetables/${this.id}/show`);\r\n                this.timetable = response.data;\r\n            } catch (error) {\r\n                console.error('Erreur:', error);\r\n                toastr.error('Erreur lors du chargement des données');\r\n            }\r\n        },\r\n        formatDate(dateString) {\r\n            const date = new Date(dateString);\r\n            return date.toLocaleString('fr-FR');\r\n        },\r\n        async copyXml() {\r\n            try {\r\n                await navigator.clipboard.writeText(this.timetable.xmlData);\r\n                toastr.success('XML copié dans le presse-papier');\r\n            } catch (error) {\r\n                console.error('Erreur lors de la copie:', error);\r\n                toastr.error('Échec de la copie');\r\n            }\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n@import 'https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css';\r\npre {\r\n    white-space: pre-wrap;\r\n    word-wrap: break-word;\r\n}\r\n</style>"],"mappings":"AA8CA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACHC,EAAE,EAAE;MACAC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,SAAS,EAAE;QACPD,IAAI,EAAE,CAAC,CAAC;QACRE,UAAU,EAAE,EAAE;QACdC,OAAO,EAAE;MACb;IA