{"ast":null,"code":"export default {\n  name: 'StudentsTab',\n  props: {\n    students: Array,\n    errors: Object\n  }\n};","map":{"version":3,"names":["name","props","students","Array","errors","Object"],"sources":["C:\\laragon\\www\\front\\src\\components\\timetable\\StudentsTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Apprenants:</label>\r\n    <div class=\"students-container\">\r\n      <div class=\"student-item mb-3\" v-for=\"(student, index) in students\" :key=\"'student-'+index\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'student-name-' + index\" class=\"form-label\">Nom:</label>\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" \r\n                   :id=\"'student-name-' + index\" v-model=\"student.name\">\r\n          </div>\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'student-code-' + index\" class=\"form-label\">Code:</label>\r\n            <input type=\"text\" class=\"form-control\" :id=\"'student-code-' + index\" v-model=\"student.code\">\r\n          </div>\r\n          <div class=\"col-md-4 mb-3\">\r\n            <label :for=\"'student-longname-' + index\" class=\"form-label\">Nom complet:</label>\r\n            <input type=\"text\" class=\"form-control\" :id=\"'student-longname-' + index\" v-model=\"student.longName\">\r\n          </div>\r\n        </div>\r\n        <div class=\"row\">\r\n          <div class=\"col-md-6 mb-3\">\r\n            <label :for=\"'student-count-' + index\" class=\"form-label\">Nombre d'étudiants:</label>\r\n            <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'student-count-' + index\" v-model=\"student.studentCount\">\r\n          </div>\r\n        </div>\r\n        <div class=\"mb-3\">\r\n          <label :for=\"'student-comments-' + index\" class=\"form-label\">Commentaires:</label>\r\n          <textarea class=\"form-control\" :id=\"'student-comments-' + index\" \r\n                    v-model=\"student.comments\" rows=\"2\"></textarea>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"$emit('remove-student', index)\">\r\n          <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n        </button>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-student')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter un groupe d'apprenants\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'StudentsTab',\r\n  props: {\r\n    students: Array,\r\n    errors: Object\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA2CA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,QAAQ,EAAEC,KAAK;IACfC,MAAM,EAAEC;EACV;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}