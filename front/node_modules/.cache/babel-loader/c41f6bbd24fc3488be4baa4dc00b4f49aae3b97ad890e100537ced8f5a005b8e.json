{"ast":null,"code":"export default {\n  name: 'BasicInfoTab',\n  props: {\n    formData: Object,\n    errors: Object,\n    daysOfWeek: Array\n  }\n};","map":{"version":3,"names":["name","props","formData","Object","errors","daysOfWeek","Array"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\BasicInfoTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"mb-3\">\r\n      <label for=\"institutionName\" class=\"form-label\">Nom de l'institution:</label>\r\n      <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors.institutionName}\" \r\n             id=\"institutionName\" v-model=\"formData.institutionName\">\r\n    </div>\r\n    <div class=\"mb-3\">\r\n      <label for=\"institutionComment\" class=\"form-label\">Commentaire:</label>\r\n      <textarea class=\"form-control\" id=\"institutionComment\" \r\n                v-model=\"formData.institutionComment\" rows=\"3\"></textarea>\r\n    </div>\r\n    <div class=\"mb-3\">\r\n      <label class=\"form-label\">Jours d'ouverture:</label>\r\n      <div class=\"d-flex flex-wrap gap-3\">\r\n        <div class=\"form-check\" v-for=\"day in daysOfWeek\" :key=\"day.value\">\r\n          <input class=\"form-check-input\" type=\"checkbox\" :id=\"'day-' + day.value\" \r\n                 v-model=\"formData.selectedDays\" :value=\"day.value\">\r\n          <label class=\"form-check-label\" :for=\"'day-' + day.value\">{{ day.label }}</label>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    <div class=\"mb-4\">\r\n      <label class=\"form-label\">Périodes:</label>\r\n      <div class=\"periods-container\">\r\n        <div class=\"period-item mb-3\" v-for=\"(period, index) in formData.periods\" :key=\"'period-'+index\">\r\n          <div class=\"mb-3\">\r\n            <label :for=\"'period-name-' + index\" class=\"form-label\">Nom de la période:</label>\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors.periods && errors.periods[index]}\" \r\n                   :id=\"'period-name-' + index\" v-model=\"period.name\">\r\n          </div>\r\n          <div class=\"mb-3\">\r\n            <label :for=\"'period-desc-' + index\" class=\"form-label\">Description:</label>\r\n            <textarea class=\"form-control\" :id=\"'period-desc-' + index\" \r\n                      v-model=\"period.description\" rows=\"2\"></textarea>\r\n          </div>\r\n          <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"$emit('remove-period', index)\">\r\n            <i class=\"fas fa-trash me-1\"></i>Supprimer\r\n          </button>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-period')\">\r\n          <i class=\"fas fa-plus me-1\"></i>Ajouter une période\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: 'BasicInfoTab',\r\n    props: {\r\n        formData: Object,\r\n        errors: Object,\r\n        daysOfWeek: Array\r\n    }\r\n}\r\n</script>\r\n"],"mappings":"AAiDA,eAAe;EACXA,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE;IACHC,QAAQ,EAAEC,MAAM;IAChBC,MAAM,EAAED,MAAM;IACdE,UAAU,EAAEC;EAChB;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}