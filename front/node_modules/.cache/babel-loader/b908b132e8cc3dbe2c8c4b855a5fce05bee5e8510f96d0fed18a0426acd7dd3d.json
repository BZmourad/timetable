{"ast":null,"code":"import axios from 'axios';\nimport toastr from 'toastr';\nexport default {\n  name: 'ShowTimetable',\n  props: {\n    id: {\n      type: String,\n      required: true\n    }\n  },\n  data() {\n    return {\n      timetable: {\n        data: {},\n        created_at: '',\n        xmlData: '',\n        output_html: null\n      },\n      isLoading: false,\n      error: null\n    };\n  },\n  computed: {\n    formattedJson() {\n      return JSON.stringify(this.timetable.data, null, 2);\n    }\n  },\n  created() {\n    this.loadTimetableData();\n  },\n  beforeUnmount() {\n    if (this.currentRequest) {\n      this.currentRequest.cancel();\n    }\n  },\n  methods: {\n    async loadTimetableData() {\n      this.isLoading = true;\n      this.error = null;\n      try {\n        const response = await axios.get(`${process.env.VUE_APP_API_BASE_URL}/timetables/${this.id}/show`);\n        console.log('response', response);\n        // Transform output path if needed\n        this.timetable = response.data;\n        /*this.timetable = {\r\n            ...response.data,\r\n            output_html: response.data.output_html \r\n                ? `${process.env.VUE_APP_API_BASE_URL}${response.data.output_html}`\r\n                : null\r\n        };*/\n      } catch (error) {\n        console.error('Error:', error);\n        this.error = 'Failed to load timetable data';\n        toastr.error(this.error);\n      } finally {\n        this.isLoading = false;\n      }\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleString('fr-FR');\n    },\n    async copyXml() {\n      try {\n        await navigator.clipboard.writeText(this.timetable.xmlData);\n        toastr.success('XML copié dans le presse-papier');\n      } catch (error) {\n        console.error('Erreur lors de la copie:', error);\n        toastr.error('Échec de la copie');\n      }\n    },\n    async copyJSON() {\n      try {\n        await navigator.clipboard.writeText(this.formattedJson);\n        toastr.success('XML copié dans le presse-papier');\n      } catch (error) {\n        console.error('Erreur lors de la copie:', error);\n        toastr.error('Échec de la copie');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","toastr","name","props","id","type","String","required","data","timetable","created_at","xmlData","output_html","isLoading","error","computed","formattedJson","JSON","stringify","created","loadTimetableData","beforeUnmount","currentRequest","cancel","methods","response","get","process","env","VUE_APP_API_BASE_URL","console","log","formatDate","dateString","date","Date","toLocaleString","copyXml","navigator","clipboard","writeText","success","copyJSON"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\views\\ShowTimetable.vue"],"sourcesContent":["<template>\r\n    <nav class=\"navbar navbar-expand-lg navbar-light bg-secondary\">\r\n        <div class=\"container-fluid\">\r\n            <h2 class=\"navbar-brand text-white\"><i class=\"fas fa-calendar-alt me-2\"></i>Détails de l'Emploi du Temps</h2>\r\n            <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarNav\">\r\n                <span class=\"navbar-toggler-icon\"></span>\r\n            </button>\r\n            <div class=\"collapse navbar-collapse justify-content-end\" id=\"navbarNav\">\r\n                <div class=\"navbar-nav\">\r\n                    <router-link to=\"/\" class=\"btn btn-white me-2\">\r\n                        <i class=\"fas fa-arrow-left me-1\"></i>Retour\r\n                    </router-link>\r\n                    <router-link :to=\"'/edit/' + id\" class=\"btn btn-primary\">\r\n                        <i class=\"fas fa-edit me-1\"></i> Modifier\r\n                    </router-link>\r\n                    <button @click=\"loadTimetableData\" class=\"btn btn-sm btn-danger\">\r\n                        <i class=\"fas fa-check\"></i> generate timetable\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </nav>\r\n    <div class=\"p-2 mt-4\">\r\n        <div class=\"row\">\r\n            <!-- Vertical Tabs Navigation -->\r\n            <div class=\"col-md-3\">\r\n                <div class=\"nav flex-column nav-pills\" id=\"v-pills-tab\" role=\"tablist\" aria-orientation=\"vertical\">\r\n                    <button class=\"nav-link active\" id=\"v-pills-info-tab\" data-bs-toggle=\"pill\" data-bs-target=\"#v-pills-info\" type=\"button\" role=\"tab\">\r\n                        <i class=\"fas fa-info-circle me-2\"></i>Informations de base\r\n                    </button>\r\n                    <button class=\"nav-link\" id=\"v-pills-json-tab\" data-bs-toggle=\"pill\" data-bs-target=\"#v-pills-json\" type=\"button\" role=\"tab\">\r\n                        <i class=\"fas fa-code me-2\"></i>Données JSON\r\n                    </button>\r\n                    <button class=\"nav-link\" id=\"v-pills-xml-tab\" data-bs-toggle=\"pill\" data-bs-target=\"#v-pills-xml\" type=\"button\" role=\"tab\">\r\n                        <i class=\"fas fa-file-code me-2\"></i>Données XML\r\n                    </button>\r\n                    <button class=\"nav-link\" id=\"v-pills-result-tab\" data-bs-toggle=\"pill\" data-bs-target=\"#v-pills-result\" type=\"button\" role=\"tab\">\r\n                        <i class=\"fas fa-calendar-day me-2\"></i>Résultat final\r\n                    </button>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Tab Content -->\r\n            <div class=\"col-md-9\">\r\n                <div class=\"tab-content\" id=\"v-pills-tabContent\">\r\n                    <!-- Basic Info Tab -->\r\n                    <div class=\"tab-pane fade show active\" id=\"v-pills-info\" role=\"tabpanel\">\r\n                        <div class=\"card\">\r\n                            <div class=\"card-header bg-primary text-white\">\r\n                                <h5 class=\"mb-0\"><i class=\"fas fa-info-circle me-2\"></i>Informations de base</h5>\r\n                            </div>\r\n                            <div class=\"card-body\">\r\n                                <p v-if=\"timetable.data\"><strong>Institution:</strong> {{ timetable.data.institutionName }}</p>\r\n                                <p><strong>Créé le:</strong> {{ formatDate(timetable.created_at) }}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- JSON Data Tab -->\r\n                    <div class=\"tab-pane fade\" id=\"v-pills-json\" role=\"tabpanel\">\r\n                        <div class=\"card\">\r\n                            <div class=\"card-header bg-primary text-white d-flex justify-content-between align-items-center\">\r\n                                <h5 class=\"mb-0\"><i class=\"fas fa-code me-2\"></i>Données complètes (JSON)</h5>\r\n                                <button @click=\"copyJSON\" class=\"btn btn-sm btn-light\">\r\n                                    <i class=\"fas fa-copy\"></i> Copier\r\n                                </button>\r\n                            </div>\r\n                            <div class=\"card-body\">\r\n                                <pre class=\"p-3 bg-light rounded\">{{ formattedJson }}</pre>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- XML Data Tab -->\r\n                    <div class=\"tab-pane fade\" id=\"v-pills-xml\" role=\"tabpanel\">\r\n                        <div class=\"card\">\r\n                            <div class=\"card-header bg-primary text-white d-flex justify-content-between align-items-center\">\r\n                                <h5 class=\"mb-0\"><i class=\"fas fa-file-code me-2\"></i>Données au format XML (FET)</h5>\r\n                                <button @click=\"copyXml\" class=\"btn btn-sm btn-light\">\r\n                                    <i class=\"fas fa-copy\"></i> Copier\r\n                                </button>\r\n                            </div>\r\n                            <div class=\"card-body\">\r\n                                <pre class=\"p-3 bg-light rounded\">{{ timetable.xmlData }}</pre>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Result Tab Content -->\r\n                    <div class=\"tab-pane fade\" id=\"v-pills-result\" role=\"tabpanel\">\r\n                        <div class=\"card\">\r\n                            <div class=\"card-body\">\r\n                                <div v-if=\"isLoading\" class=\"text-center py-5\">\r\n                                    <div class=\"spinner-border text-primary\" role=\"status\">\r\n                                        <span class=\"visually-hidden\">Loading...</span>\r\n                                    </div>\r\n                                    <p class=\"mt-2\">Generating timetable...</p>\r\n                                </div>\r\n                                \r\n                                <div v-else-if=\"timetable.output_html\">\r\n                                    <iframe \r\n                                        :src=\"timetable.output_html\" \r\n                                        frameborder=\"0\" \r\n                                        style=\"width: 100%; height: 800px;\"\r\n                                        @load=\"iframeLoaded\"\r\n                                        @error=\"iframeError\"\r\n                                    ></iframe>\r\n                                </div>\r\n                                \r\n                                <div v-else class=\"alert alert-warning\">\r\n                                    No HTML output was generated.\r\n                                    <button @click=\"loadTimetableData\" class=\"btn btn-sm btn-primary ms-2\">\r\n                                        Retry\r\n                                    </button>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\nimport toastr from 'toastr';\r\n\r\nexport default {\r\n    name: 'ShowTimetable',\r\n    props: {\r\n        id: {\r\n            type: String,\r\n            required: true\r\n        }\r\n    },\r\n    data() {\r\n        return {\r\n            timetable: {\r\n                data: {},\r\n                created_at: '',\r\n                xmlData: '',\r\n                output_html: null\r\n            },\r\n            isLoading: false,\r\n            error: null\r\n        };\r\n    },\r\n    computed: {\r\n        formattedJson() {\r\n            return JSON.stringify(this.timetable.data, null, 2);\r\n        }\r\n    },\r\n    created() {\r\n        this.loadTimetableData();\r\n    },\r\n    beforeUnmount() {\r\n        if (this.currentRequest) {\r\n            this.currentRequest.cancel();\r\n        }\r\n    },\r\n    methods: {\r\n        async loadTimetableData() {\r\n            this.isLoading = true;\r\n            this.error = null;\r\n            try {\r\n                const response = await axios.get(\r\n                    `${process.env.VUE_APP_API_BASE_URL}/timetables/${this.id}/show`\r\n                );\r\n                console.log('response', response);\r\n                // Transform output path if needed\r\n                this.timetable = response.data;\r\n                /*this.timetable = {\r\n                    ...response.data,\r\n                    output_html: response.data.output_html \r\n                        ? `${process.env.VUE_APP_API_BASE_URL}${response.data.output_html}`\r\n                        : null\r\n                };*/\r\n                \r\n            } catch (error) {\r\n                console.error('Error:', error);\r\n                this.error = 'Failed to load timetable data';\r\n                toastr.error(this.error);\r\n            } finally {\r\n                this.isLoading = false;\r\n            }\r\n        },\r\n        formatDate(dateString) {\r\n            const date = new Date(dateString);\r\n            return date.toLocaleString('fr-FR');\r\n        },\r\n        async copyXml() {\r\n            try {\r\n                await navigator.clipboard.writeText(this.timetable.xmlData);\r\n                toastr.success('XML copié dans le presse-papier');\r\n            } catch (error) {\r\n                console.error('Erreur lors de la copie:', error);\r\n                toastr.error('Échec de la copie');\r\n            }\r\n        },\r\n\r\n        async copyJSON() {\r\n            try {\r\n                await navigator.clipboard.writeText(this.formattedJson);\r\n                toastr.success('XML copié dans le presse-papier');\r\n            } catch (error) {\r\n                console.error('Erreur lors de la copie:', error);\r\n                toastr.error('Échec de la copie');\r\n            }\r\n        }\r\n    }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n@import 'https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css';\r\n.nav-pills .nav-link {\r\n    text-align: left;\r\n    padding: 0.75rem 1rem;\r\n    margin-bottom: 0.5rem;\r\n    border-radius: 0.25rem;\r\n    transition: all 0.3s ease;\r\n}\r\n\r\n.nav-pills .nav-link.active {\r\n    background-color: #0d6efd;\r\n    color: white;\r\n}\r\n\r\n.nav-pills .nav-link:not(.active) {\r\n    color: #495057;\r\n    background-color: #f8f9fa;\r\n}\r\n\r\n.nav-pills .nav-link:not(.active):hover {\r\n    background-color: #e9ecef;\r\n}\r\n\r\n.card {\r\n    border: none;\r\n    box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);\r\n}\r\n\r\n.card-header {\r\n    border-bottom: 1px solid rgba(0, 0, 0, 0.125);\r\n}\r\n\r\npre {\r\n    white-space: pre-wrap;\r\n    word-wrap: break-word;\r\n    max-height: 500px;\r\n    overflow-y: auto;\r\n}\r\n</style>"],"mappings":"AA6HA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,eAAe;EACrBC,KAAK,EAAE;IACHC,EAAE,EAAE;MACAC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,IAAIA,CAAA,EAAG;IACH,OAAO;MACHC,SAAS,EAAE;QACPD,IAAI,EAAE,CAAC,CAAC;QACRE,UAAU,EAAE,EAAE;QACdC,OAAO,EAAE,EAAE;QACXC,WAAW,EAAE;MACjB,CAAC;MACDC,SAAS,EAAE,KAAK;MAChBC,KAAK,EAAE;IACX,CAAC;EACL,CAAC;EACDC,QAAQ,EAAE;IACNC,aAAaA,CAAA,EAAG;MACZ,OAAOC,IAAI,CAACC,SAAS,CAAC,IAAI,CAACT,SAAS,CAACD,IAAI,EAAE,IAAI,EAAE,CAAC,CAAC;IACvD;EACJ,CAAC;EACDW,OAAOA,CAAA,EAAG;IACN,IAAI,CAACC,iBAAiB,CAAC,CAAC;EAC5B,CAAC;EACDC,aAAaA,CAAA,EAAG;IACZ,IAAI,IAAI,CAACC,cAAc,EAAE;MACrB,IAAI,CAACA,cAAc,CAACC,MAAM,CAAC,CAAC;IAChC;EACJ,CAAC;EACDC,OAAO,EAAE;IACL,MAAMJ,iBAAiBA,CAAA,EAAG;MACtB,IAAI,CAACP,SAAQ,GAAI,IAAI;MACrB,IAAI,CAACC,KAAI,GAAI,IAAI;MACjB,IAAI;QACA,MAAMW,QAAO,GAAI,MAAMzB,KAAK,CAAC0B,GAAG,CAC5B,GAAGC,OAAO,CAACC,GAAG,CAACC,oBAAoB,eAAe,IAAI,CAACzB,EAAE,OAC7D,CAAC;QACD0B,OAAO,CAACC,GAAG,CAAC,UAAU,EAAEN,QAAQ,CAAC;QACjC;QACA,IAAI,CAAChB,SAAQ,GAAIgB,QAAQ,CAACjB,IAAI;QAC9B;;;;;;MAOJ,EAAE,OAAOM,KAAK,EAAE;QACZgB,OAAO,CAAChB,KAAK,CAAC,QAAQ,EAAEA,KAAK,CAAC;QAC9B,IAAI,CAACA,KAAI,GAAI,+BAA+B;QAC5Cb,MAAM,CAACa,KAAK,CAAC,IAAI,CAACA,KAAK,CAAC;MAC5B,UAAU;QACN,IAAI,CAACD,SAAQ,GAAI,KAAK;MAC1B;IACJ,CAAC;IACDmB,UAAUA,CAACC,UAAU,EAAE;MACnB,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAACF,UAAU,CAAC;MACjC,OAAOC,IAAI,CAACE,cAAc,CAAC,OAAO,CAAC;IACvC,CAAC;IACD,MAAMC,OAAOA,CAAA,EAAG;MACZ,IAAI;QACA,MAAMC,SAAS,CAACC,SAAS,CAACC,SAAS,CAAC,IAAI,CAAC/B,SAAS,CAACE,OAAO,CAAC;QAC3DV,MAAM,CAACwC,OAAO,CAAC,iCAAiC,CAAC;MACrD,EAAE,OAAO3B,KAAK,EAAE;QACZgB,OAAO,CAAChB,KAAK,CAAC,0BAA0B,EAAEA,KAAK,CAAC;QAChDb,MAAM,CAACa,KAAK,CAAC,mBAAmB,CAAC;MACrC;IACJ,CAAC;IAED,MAAM4B,QAAQA,CAAA,EAAG;MACb,IAAI;QACA,MAAMJ,SAAS,CAACC,SAAS,CAACC,SAAS,CAAC,IAAI,CAACxB,aAAa,