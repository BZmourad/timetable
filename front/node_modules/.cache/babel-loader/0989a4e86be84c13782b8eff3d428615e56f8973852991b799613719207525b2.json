ble","components","props","formData","type","Object","required","data","selectedConstraintType","showConstraintModal","newConstraint","computed","modalTitle","titles","currentConstraintComponent","replace","toLowerCase","methods","openAddConstraintModal","getDefaultConstraint"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\ConstraintsTab.vue"],"sourcesContent":["<template>\r\n  <div class=\"constraints-tab\">\r\n    <div class=\"constraint-selection\">\r\n      <select class=\"form-control\" id=\"constraintType\" v-model=\"selectedConstraintType\">\r\n        <option value=\"\" disabled>-- Sélectionnez un type --</option>\r\n        <optgroup label=\"Contraintes temporelles\">\r\n          <option value=\"ConstraintBreakTimes\">Temps de pause</option>\r\n          <option value=\"ConstraintTeacherNotAvailableTimes\">Enseignant non disponible</option>\r\n          <option value=\"ConstraintTeacherMaxDaysPerWeek\">Jours max/semaine</option>\r\n          <option value=\"ConstraintTeacherMinDaysPerWeek\">Jours min/semaine</option>\r\n          <option value=\"ConstraintTeacherNoTwoConsecutiveDays\">Pas 2 jours consécutifs</option>\r\n        </optgroup>\r\n      </select>\r\n      <button \r\n        type=\"button\" \r\n        class=\"btn btn-primary\" \r\n        @click=\"openAddConstraintModal\" \r\n        :disabled=\"!selectedConstraintType\">\r\n        Ajouter\r\n      </button>\r\n    </div>\r\n\r\n    <!-- Modal -->\r\n    <div v-if=\"showConstraintModal\" class=\"modal\" @click.self=\"closeConstraintModal\">\r\n      <div class=\"modal-content\">\r\n        <span class=\"close\" @click=\"closeConstraintModal\">&times;</span>\r\n        \r\n        <h3>{{ modalTitle }}</h3>\r\n        \r\n        <component \r\n          :is=\"currentConstraintComponent\" \r\n          :constraint=\"newConstraint\"\r\n          :days=\"formData.selectedDays\"\r\n          :periods=\"formData.periods\"\r\n          :teachers=\"formData.teachers\"\r\n          @add-period=\"addUnavailablePeriod\"\r\n          @remove-period=\"removeUnavailablePeriod\"\r\n        />\r\n\r\n        <div class=\"modal-footer\">\r\n          <button class=\"btn btn-secondary\" @click=\"closeConstraintModal\">Annuler</button>\r\n          <button class=\"btn btn-primary\" @click=\"addConstraint\">Valider</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Tableau des contraintes -->\r\n    <ConstraintsTable \r\n      :constraints=\"formData.contraintes\" \r\n      :teachers=\"formData.teachers\"\r\n      @remove=\"removeConstraint\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport BreakTimesConstraint from './constraints/BreakTimesConstraint.vue';\r\nimport TeacherNotAvailableTimes from './constraints/TeacherNotAvailableTimes.vue';\r\nimport TeacherMaxDaysPerWeek from './constraints/TeacherMaxDaysPerWeek.vue';\r\nimport TeacherMinDaysPerWeek from './constraints/TeacherMinDaysPerWeek.vue';\r\nimport TeacherNoTwoConsecutiveDays from './constraints/TeacherNoTwoConsecutiveDays.vue';\r\nimport ConstraintsTable from './constraints/ConstraintsTable.vue';\r\n\r\nexport default {\r\n  components: {\r\n    BreakTimesConstraint,\r\n    TeacherNotAvailableTimes,\r\n    TeacherMaxDaysPerWeek,\r\n    TeacherMinDaysPerWeek,\r\n    TeacherNoTwoConsecutiveDays,\r\n    ConstraintsTable\r\n  },\r\n  props: {\r\n    formData: {\r\n      type: Object,\r\n      required: true\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      selectedConstraintType: '',\r\n      showConstraintModal: false,\r\n      newConstraint: {}\r\n    }\r\n  },\r\n  computed: {\r\n    modalTitle() {\r\n      const titles = {\r\n        'ConstraintBreakTimes': 'Ajouter un temps de pause',\r\n        'ConstraintTeacherNotAvailableTimes': 'Enseignant non disponible',\r\n        'ConstraintTeacherMaxDaysPerWeek': 'Jours max/semaine (enseignant)',\r\n        'ConstraintTeacherMinDaysPerWeek': 'Jours min/semaine (enseignant)',\r\n        'ConstraintTeacherNoTwoConsecutiveDays': 'Pas 2 jours consécutifs'\r\n      };\r\n      return titles[this.selectedConstraintType] || 'Ajouter une contrainte';\r\n    },\r\n    currentConstraintComponent() {\r\n      return this.selectedConstraintType.replace('Constraint', '').toLowerCase();\r\n    }\r\n  },\r\n  methods: {\r\n    openAddConstraintModal() {\r\n      if (!this.selectedConstraintType) return;\r\n      \r\n      this.newConstraint = this.getDefaultConstraint();\r\n      this.showConstraintModal = true;\r\n    },\r\n    // ... autres méthodes inchangées\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* Styles inchangés */\r\n.modal {\r\n  position: fixed;\r\n  z-index: 1000;\r\n  /* ... */\r\n}\r\n\r\n.modal-content {\r\n  z-index: 1001;\r\n  /* ... */\r\n}\r\n</style>"],"mappings":"AAwDA,OAAOA,oBAAmB,MAAO,wCAAwC;AACzE,OAAOC,wBAAuB,MAAO,4CAA4C;AACjF,OAAOC,qBAAoB,MAAO,yCAAyC;AAC3E,OAAOC,qBAAoB,MAAO,yCAAyC;AAC3E,OAAOC,2BAA0B,MAAO,+CAA+C;AACvF,OAAOC,gBAAe,MAAO,oCAAoC;AAEjE,eAAe;EACbC,UAAU,EAAE;IACVN,oBAAoB;IACpBC,wBAAwB;IACxBC,qBAAqB;IACrBC,qBAAqB;IACrBC,2BAA2B;IAC3BC;EACF,CAAC;EACDE,KAAK,EAAE;IACLC,QAAQ,EAAE;MACRC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACZ;EACF,CAAC;EACDC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,sBAAsB,EAAE,EAAE;MAC1BC,mBAAmB,EAAE,KAAK;MAC1BC,aAAa,EAAE,CAAC;IAClB;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,UAAUA,CAAA,EAAG;MACX,MAAMC,MAAK,GAAI;QACb,sBAAsB,EAAE,2BAA2B;QACnD,oCAAoC,EAAE,2BAA2B;QACjE,iCAAiC,EAAE,gCAAgC;QACnE,iCAAiC,EAAE,gCAAgC;QACnE,uCAAuC,EAAE;MAC3C,CAAC;MACD,OAAOA,MAAM,CAAC,IAAI,CAACL,sBAAsB,KAAK,wBAAwB;IACxE,CAAC;IACDM,0BAA0BA,CAAA,EAAG;MAC3B,OAAO,IAAI,CAACN,sBAAsB,CAACO,OAAO,CAAC,YAAY,EAAE,EAAE,CAAC,CAACC,WAAW,CAAC,CAAC;IAC5E;EACF,CAAC;EACDC,OAAO,EAAE;IACPC,sBAAsBA,CAAA,EAAG;MACvB,IAAI,CAAC,IAAI,CAACV,sBAAsB,EAAE;MAElC,IAAI,CAACE,aAAY,GAAI,IAAI,CAACS,oBAAoB,CAAC,CAAC;MAChD,IAAI,CAACV,mBAAkB,GAAI,IAAI;IACjC;IACA;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}