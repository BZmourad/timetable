{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { Modal } from 'bootstrap';\nexport default {\n  name: 'ConstraintsTab',\n  props: {\n    formData: Object,\n    daysOfWeek: Array\n  },\n  data() {\n    return {\n      selectedConstraintType: '',\n      constraintModal: null,\n      constraintForm: {\n        type: '',\n        title: '',\n        fields: null,\n        data: {}\n      },\n      constraintGroups: {\n        'Contraintes temporelles': [{\n          label: 'Temps de pause',\n          value: 'ConstraintBreakTimes',\n          fields: [{\n            label: 'Jour',\n            name: 'day',\n            type: 'select',\n            options: 'days'\n          }, {\n            label: 'Heure',\n            name: 'hour',\n            type: 'select',\n            options: 'periods'\n          }]\n        }, {\n          label: 'Enseignants',\n          children: [{\n            label: 'Enseignant non disponible',\n            value: 'ConstraintTeacherNotAvailableTimes',\n            fields: [{\n              label: 'Enseignant',\n              name: 'teacher',\n              type: 'select',\n              options: 'teachers'\n            }, {\n              label: 'Périodes non disponibles',\n              name: 'periods',\n              type: 'multiple',\n              fields: [{\n                label: 'Jour',\n                name: 'day',\n                type: 'select',\n                options: 'days'\n              }, {\n                label: 'Heure',\n                name: 'hour',\n                type: 'select',\n                options: 'periods'\n              }]\n            }]\n          }, {\n            label: 'Jours max/semaine (enseignant)',\n            value: 'ConstraintTeacherMaxDaysPerWeek',\n            fields: [{\n              label: 'Enseignant',\n              name: 'teacher',\n              type: 'select',\n              options: 'teachers'\n            }, {\n              label: 'Jours max/semaine',\n              name: 'maxDays',\n              type: 'number',\n              min: 0\n            }]\n          }\n          // Ajouter les autres contraintes ici...\n          ]\n        }\n        // Ajouter les autres groupes ici...\n        ]\n        // Ajouter les autres catégories de contraintes ici...\n      }\n    };\n  },\n  mounted() {\n    this.constraintModal = new Modal(document.getElementById('constraintModal'));\n  },\n  methods: {\n    getOptions(type) {\n      switch (type) {\n        case 'days':\n          return this.daysOfWeek.map(day => ({\n            value: day.value,\n            label: day.label\n          }));\n        case 'periods':\n          return this.formData.periods.map(p => ({\n            value: p.name,\n            label: p.name\n          }));\n        case 'teachers':\n          return this.formData.teachers.map(t => ({\n            value: t.name,\n            label: t.name\n          }));\n        default:\n          return [];\n      }\n    },\n    getConstraintLabel(type) {\n      // Recherche récursive dans la structure des contraintes\n      const findLabel = (groups, searchType) => {\n        for (const group of Object.values(groups)) {\n          for (const item of group) {\n            if (item.value === searchType) return item.label;\n            if (item.children) {\n              for (const child of item.children) {\n                if (child.value === searchType) return child.label;\n              }\n            }\n          }\n        }\n        return type;\n      };\n      return findLabel(this.constraintGroups, type);\n    },\n    openConstraintModal() {\n      const constraintType = this.selectedConstraintType;\n      const constraintConfig = this.findConstraintConfig(constraintType);\n      if (!constraintConfig) return;\n      this.constraintForm = {\n        type: constraintType,\n        title: `Ajouter une contrainte: ${this.getConstraintLabel(constraintType)}`,\n        fields: constraintConfig.fields,\n        data: this.initializeConstraintData(constraintConfig.fields)\n      };\n      this.constraintModal.show();\n    },\n    findConstraintConfig(type) {\n      // Recherche récursive dans la structure des contraintes\n      for (const group of Object.values(this.constraintGroups)) {\n        for (const item of group) {\n          if (item.value === type) return item;\n          if (item.children) {\n            for (const child of item.children) {\n              if (child.value === type) return child;\n            }\n          }\n        }\n      }\n      return null;\n    },\n    initializeConstraintData(fields) {\n      const data = {};\n      fields.forEach(field => {\n        if (field.type === 'multiple') {\n          data[field.name] = [this.createPeriodItem()];\n        } else {\n          data[field.name] = field.type === 'boolean' ? false : '';\n        }\n      });\n      return data;\n    },\n    createPeriodItem() {\n      return {\n        day: this.formData.selectedDays[0] || '',\n        hour: this.formData.periods[0]?.name || ''\n      };\n    },\n    addPeriod(fieldName) {\n      this.constraintForm.data[fieldName].push(this.createPeriodItem());\n    },\n    removePeriod(fieldName, index) {\n      if (this.constraintForm.data[fieldName].length > 1) {\n        this.constraintForm.data[fieldName].splice(index, 1);\n      }\n    },\n    saveConstraint() {\n      this.formData.contraintes.push({\n        type: this.constraintForm.type,\n        ...this.constraintForm.data\n      });\n      this.constraintModal.hide();\n      this.selectedConstraintType = '';\n    },\n    removeConstraint(index) {\n      this.formData.contraintes.splice(index, 1);\n    }\n  }\n};","map":{"version":3,"names":["Modal","name","props","formData","Object","daysOfWeek","Array","data","selectedConstraintType","constraintModal","constraintForm","type","title","fields","constraintGroups","label","value","options","children","min","mounted","document","getElementById","methods","getOptions","map","day","periods","p","teachers","t","getConstraintLabel","findLabel","groups","searchType","group","values","item","child","openConstraintModal","constraintType","constraintConfig","findConstraintConfig","initializeConstraintData","show","forEach","field","createPeriodItem","selectedDays","hour","addPeriod","fieldName","push","removePeriod","index","length","splice","saveConstraint","contraintes","hide","removeConstraint"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\ConstraintsTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <div class=\"mb-4\">\r\n      <div class=\"row\">\r\n        <div class=\"col-md-8\">\r\n          <select class=\"form-control\" v-model=\"selectedConstraintType\">\r\n            <option value=\"\">-- Sélectionnez un type --</option>\r\n            <optgroup v-for=\"(group, groupName) in constraintGroups\" :key=\"groupName\" :label=\"groupName\">\r\n              <template v-for=\"constraint in group\">\r\n                <option v-if=\"!constraint.children\" :key=\"constraint.value\" :value=\"constraint.value\">\r\n                  {{ constraint.label }}\r\n                </option>\r\n                <optgroup v-else :key=\"`sub-${constraint.label}`\" :label=\"`  ► ${constraint.label}`\">\r\n                  <option v-for=\"subConstraint in constraint.children\" :key=\"subConstraint.value\" :value=\"subConstraint.value\">\r\n                    {{ subConstraint.label }}\r\n                  </option>\r\n                </optgroup>\r\n              </template>\r\n            </optgroup>\r\n          </select>\r\n        </div>\r\n        <div class=\"col-md-4\">\r\n          <button class=\"btn btn-primary\" type=\"button\" @click=\"openConstraintModal\" :disabled=\"!selectedConstraintType\">\r\n            <i class=\"fas fa-plus me-1\"></i> Ajouter contrainte\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Modal pour ajouter/modifier une contrainte -->\r\n    <div class=\"modal fade\" id=\"constraintModal\" tabindex=\"-1\" aria-hidden=\"true\">\r\n      <div class=\"modal-dialog modal-lg\">\r\n        <div class=\"modal-content\">\r\n          <div class=\"modal-header\">\r\n            <h5 class=\"modal-title\">{{ constraintForm.title }}</h5>\r\n            <button type=\"button\" class=\"btn-close\" data-bs-dismiss=\"modal\" aria-label=\"Close\"></button>\r\n          </div>\r\n          <div class=\"modal-body\">\r\n            <form v-if=\"constraintForm.fields\">\r\n              <div v-for=\"(field, index) in constraintForm.fields\" :key=\"index\" class=\"mb-3\">\r\n                <label class=\"form-label\">{{ field.label }}</label>\r\n                \r\n                <!-- Champ select -->\r\n                <select v-if=\"field.type === 'select'\" class=\"form-select\" v-model=\"constraintForm.data[field.name]\">\r\n                  <option v-for=\"option in getOptions(field.options)\" :value=\"option.value\">\r\n                    {{ option.label }}\r\n                  </option>\r\n                </select>\r\n                \r\n                <!-- Champ number -->\r\n                <input v-else-if=\"field.type === 'number'\" type=\"number\" class=\"form-control\" \r\n                       v-model.number=\"constraintForm.data[field.name]\" :min=\"field.min || 0\">\r\n                \r\n                <!-- Champ boolean -->\r\n                <div v-else-if=\"field.type === 'boolean'\" class=\"form-check\">\r\n                  <input class=\"form-check-input\" type=\"checkbox\" v-model=\"constraintForm.data[field.name]\">\r\n                  <label class=\"form-check-label\">{{ field.label }}</label>\r\n                </div>\r\n                \r\n                <!-- Champ multiple (pour les périodes non disponibles) -->\r\n                <div v-else-if=\"field.type === 'multiple'\">\r\n                  <div v-for=\"(item, idx) in constraintForm.data[field.name]\" :key=\"idx\" class=\"row mb-2\">\r\n                    <div class=\"col\">\r\n                      <select class=\"form-select\" v-model=\"item.day\">\r\n                        <option v-for=\"day in formData.selectedDays\" :value=\"day\">\r\n                          {{ daysOfWeek.find(d => d.value === day)?.label || day }}\r\n                        </option>\r\n                      </select>\r\n                    </div>\r\n                    <div class=\"col\">\r\n                      <select class=\"form-select\" v-model=\"item.hour\">\r\n                        <option v-for=\"period in formData.periods\" :value=\"period.name\">\r\n                          {{ period.name }}\r\n                        </option>\r\n                      </select>\r\n                    </div>\r\n                    <div class=\"col-auto\">\r\n                      <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"removePeriod(index, idx)\">\r\n                        <i class=\"fas fa-trash\"></i>\r\n                      </button>\r\n                    </div>\r\n                  </div>\r\n                  <button type=\"button\" class=\"btn btn-secondary btn-sm\" @click=\"addPeriod(field.name)\">\r\n                    <i class=\"fas fa-plus me-1\"></i> Ajouter période\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </form>\r\n          </div>\r\n          <div class=\"modal-footer\">\r\n            <button type=\"button\" class=\"btn btn-secondary\" data-bs-dismiss=\"modal\">Annuler</button>\r\n            <button type=\"button\" class=\"btn btn-primary\" @click=\"saveConstraint\">Enregistrer</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Tableau des contraintes existantes -->\r\n    <div class=\"table-responsive\">\r\n      <table class=\"table table-striped\">\r\n        <thead>\r\n          <tr>\r\n            <th>Type</th>\r\n            <th>Détails</th>\r\n            <th>Actions</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"(constraint, index) in formData.contraintes\" :key=\"index\">\r\n            <td>{{ getConstraintLabel(constraint.type) }}</td>\r\n            <td>\r\n              <div v-for=\"(value, key) in constraint\" v-if=\"key !== 'type'\">\r\n                <strong>{{ key }}:</strong> {{ Array.isArray(value) ? value.map(v => `${v.day} à ${v.hour}`).join(', ') : value }}\r\n              </div>\r\n            </td>\r\n            <td>\r\n              <button class=\"btn btn-danger btn-sm\" @click=\"removeConstraint(index)\">\r\n                <i class=\"fas fa-trash\"></i> Supprimer\r\n              </button>\r\n            </td>\r\n          </tr>\r\n          <tr v-if=\"formData.contraintes.length === 0\">\r\n            <td colspan=\"3\" class=\"text-center text-muted\">Aucune contrainte définie</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Modal } from 'bootstrap';\r\n\r\nexport default {\r\n  name: 'ConstraintsTab',\r\n  props: {\r\n    formData: Object,\r\n    daysOfWeek: Array\r\n  },\r\n  data() {\r\n    return {\r\n      selectedConstraintType: '',\r\n      constraintModal: null,\r\n      constraintForm: {\r\n        type: '',\r\n        title: '',\r\n        fields: null,\r\n        data: {}\r\n      },\r\n      constraintGroups: {\r\n        'Contraintes temporelles': [\r\n          { \r\n            label: 'Temps de pause', \r\n            value: 'ConstraintBreakTimes',\r\n            fields: [\r\n              { label: 'Jour', name: 'day', type: 'select', options: 'days' },\r\n              { label: 'Heure', name: 'hour', type: 'select', options: 'periods' }\r\n            ]\r\n          },\r\n          {\r\n            label: 'Enseignants',\r\n            children: [\r\n              {\r\n                label: 'Enseignant non disponible',\r\n                value: 'ConstraintTeacherNotAvailableTimes',\r\n                fields: [\r\n                  { label: 'Enseignant', name: 'teacher', type: 'select', options: 'teachers' },\r\n                  { \r\n                    label: 'Périodes non disponibles', \r\n                    name: 'periods', \r\n                    type: 'multiple',\r\n                    fields: [\r\n                      { label: 'Jour', name: 'day', type: 'select', options: 'days' },\r\n                      { label: 'Heure', name: 'hour', type: 'select', options: 'periods' }\r\n                    ]\r\n                  }\r\n                ]\r\n              },\r\n              {\r\n                label: 'Jours max/semaine (enseignant)',\r\n                value: 'ConstraintTeacherMaxDaysPerWeek',\r\n                fields: [\r\n                  { label: 'Enseignant', name: 'teacher', type: 'select', options: 'teachers' },\r\n                  { label: 'Jours max/semaine', name: 'maxDays', type: 'number', min: 0 }\r\n                ]\r\n              }\r\n              // Ajouter les autres contraintes ici...\r\n            ]\r\n          }\r\n          // Ajouter les autres groupes ici...\r\n        ]\r\n        // Ajouter les autres catégories de contraintes ici...\r\n      }\r\n    };\r\n  },\r\n  mounted() {\r\n    this.constraintModal = new Modal(document.getElementById('constraintModal'));\r\n  },\r\n  methods: {\r\n    getOptions(type) {\r\n      switch(type) {\r\n        case 'days': \r\n          return this.daysOfWeek.map(day => ({ value: day.value, label: day.label }));\r\n        case 'periods':\r\n          return this.formData.periods.map(p => ({ value: p.name, label: p.name }));\r\n        case 'teachers':\r\n          return this.formData.teachers.map(t => ({ value: t.name, label: t.name }));\r\n        default:\r\n          return [];\r\n      }\r\n    },\r\n    getConstraintLabel(type) {\r\n      // Recherche récursive dans la structure des contraintes\r\n      const findLabel = (groups, searchType) => {\r\n        for (const group of Object.values(groups)) {\r\n          for (const item of group) {\r\n            if (item.value === searchType) return item.label;\r\n            if (item.children) {\r\n              for (const child of item.children) {\r\n                if (child.value === searchType) return child.label;\r\n              }\r\n            }\r\n          }\r\n        }\r\n        return type;\r\n      };\r\n      \r\n      return findLabel(this.constraintGroups, type);\r\n    },\r\n    openConstraintModal() {\r\n      const constraintType = this.selectedConstraintType;\r\n      const constraintConfig = this.findConstraintConfig(constraintType);\r\n      \r\n      if (!constraintConfig) return;\r\n      \r\n      this.constraintForm = {\r\n        type: constraintType,\r\n        title: `Ajouter une contrainte: ${this.getConstraintLabel(constraintType)}`,\r\n        fields: constraintConfig.fields,\r\n        data: this.initializeConstraintData(constraintConfig.fields)\r\n      };\r\n      \r\n      this.constraintModal.show();\r\n    },\r\n    findConstraintConfig(type) {\r\n      // Recherche récursive dans la structure des contraintes\r\n      for (const group of Object.values(this.constraintGroups)) {\r\n        for (const item of group) {\r\n          if (item.value === type) return item;\r\n          if (item.children) {\r\n            for (const child of item.children) {\r\n              if (child.value === type) return child;\r\n            }\r\n          }\r\n        }\r\n      }\r\n      return null;\r\n    },\r\n    initializeConstraintData(fields) {\r\n      const data = {};\r\n      fields.forEach(field => {\r\n        if (field.type === 'multiple') {\r\n          data[field.name] = [this.createPeriodItem()];\r\n        } else {\r\n          data[field.name] = field.t