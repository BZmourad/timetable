{"ast":null,"code":"export default {\n  name: 'StudentsTab',\n  props: {\n    students: Array,\n    errors: Object\n  }\n};","map":{"version":3,"names":["name","props","students","Array","errors","Object"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\StudentsTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Apprenants:</label>\r\n    <div class=\"students-container\">\r\n      <div class=\"row\">\r\n        <div class=\"col-md-6\" v-for=\"(student, index) in students\" :key=\"'student-'+index\">\r\n          <div class=\"input-group mb-3\">\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" :id=\"'student-name-' + index\" v-model=\"student.name\" placeholder=\"Nom\">\r\n            <input type=\"number\" min=\"0\" class=\"form-control\" :id=\"'student-count-' + index\" v-model=\"student.studentCount\" placeholder=\"Nombre d'étudiants\">\r\n            <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove-student', index)\">\r\n              <i class=\"fas fa-trash\"></i>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-student')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter un groupe d'apprenants\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'StudentsTab',\r\n  props: {\r\n    students: Array,\r\n    errors: Object\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AAuBA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,QAAQ,EAAEC,KAAK;IACfC,MAAM,EAAEC;EACV;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}