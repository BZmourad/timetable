{"ast":null,"code":"export default {\n  name: 'SubjectsTab',\n  props: {\n    subjects: Array,\n    errors: Object\n  }\n};","map":{"version":3,"names":["name","props","subjects","Array","errors","Object"],"sources":["C:\\laragon\\www\\timetable\\front\\src\\components\\timetable\\SubjectsTab.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <label class=\"form-label\">Matières:</label>\r\n    <div class=\"subjects-container\">\r\n      <div class=\"subject-item mb-3\" v-for=\"(subject, index) in subjects\" :key=\"'subject-'+index\">\r\n        <div class=\"row\">\r\n          <div class=\"col-md-5\">\r\n            <input type=\"text\" class=\"form-control\" :class=\"{'is-invalid': errors[index]}\" :id=\"'subject-name-' + index\" v-model=\"subject.name\" placeholder=\"Nom\">\r\n          </div>\r\n          <div class=\"col-md-5\">\r\n            <input type=\"text\" class=\"form-control\" :id=\"'subject-longname-' + index\" v-model=\"subject.longName\" placeholder=\"Nom complet\">\r\n          </div>\r\n          <div class=\"col-md-2\">\r\n            <button type=\"button\" class=\"btn btn-danger\" @click=\"$emit('remove-subject', index)\">\r\n              <i class=\"fas fa-trash me-1\"></i>\r\n            </button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"$emit('add-subject')\">\r\n        <i class=\"fas fa-plus me-1\"></i>Ajouter une matière\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'SubjectsTab',\r\n  props: {\r\n    subjects: Array,\r\n    errors: Object\r\n  }\r\n}\r\n</script>\r\n"],"mappings":"AA2BA,eAAe;EACbA,IAAI,EAAE,aAAa;EACnBC,KAAK,EAAE;IACLC,QAAQ,EAAEC,KAAK;IACfC,MAAM,EAAEC;EACV;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}