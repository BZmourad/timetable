{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport toastr from 'toastr';\nexport default {\n  name: 'ConstraintActivityPreferredStartingTimes',\n  props: {\n    formData: {\n      type: Object,\n      required: true\n    }\n  },\n  mounted() {\n    toastr.options = {\n      closeButton: true,\n      progressBar: true,\n      positionClass: 'toast-top-right',\n      timeOut: 3000\n    };\n  },\n  methods: {\n    addConstraint() {\n      this.formData.ConstraintActivityPreferredStartingTimes.push({\n        Activity_Id: '',\n        Preferred_Starting_Time: [{\n          Day: '',\n          Hour: ''\n        }]\n      });\n    },\n    removeConstraint(index) {\n      this.formData.ConstraintActivityPreferredStartingTimes.splice(index, 1);\n    },\n    addDuration(index) {\n      this.formData.ConstraintRoomNotAvailableTimes[index].Preferred_Starting_Time.push({\n        Day: '',\n        Hour: ''\n      });\n    },\n    removeDuration(index, i) {\n      if (this.formData.ConstraintRoomNotAvailableTimes[index].Preferred_Starting_Time.length > 1) {\n        this.formData.ConstraintRoomNotAvailableTimes[index].Preferred_Starting_Time.splice(i, 1);\n      } else {\n        toastr.warning(\"Vous devez avoir au moins une péride.\");\n      }\n    }\n  }\n};","map":{"version":3,"names":["toastr","name","props","formData","type","Object","required","mounted","options","closeButton","progressBar","positionClass","timeOut","methods","addConstraint","ConstraintActivityPreferredStartingTimes","push","Activity_Id","Preferred_Starting_Time","Day","Hour","removeConstraint","index","splice","addDuration","ConstraintRoomNotAvailableTimes","removeDuration","i","length","warning"],"sources":["C:\\laragon\\www\\apps\\timetable\\front\\src\\components\\timetable\\contraintes\\temporal\\Activity\\TempsPreferes\\ConstraintActivityPreferredStartingTimes.vue"],"sourcesContent":["<template>\r\n    <div class=\"mb-3\">\r\n        <div class=\"row item1 p-1\" v-for=\"(item, index) in formData.ConstraintActivityPreferredStartingTimes\">\r\n            <div class=\"col-8\">\r\n                <label class=\"form-label\">Activité :</label>\r\n                <select class=\"form-select\" v-model=\"item.Activity_Id\" >\r\n                    <option value=\"\" disabled>Sélectionnez une activité</option>\r\n                    <option v-for=\"(activity, index) in formData.activities.filter(activity => activity.subject !== '')\" :value=\"index\">{{ index }}-{{ activity.subject }}-{{ activity.student }}-{{ activity.teacher }}-{{ activity.balise }}</option>\r\n                </select>\r\n            </div>\r\n            <div class=\"col-3 mt-4\">\r\n                <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"removeConstraint(index)\">\r\n                    <i class=\"fas fa-trash me-1\"></i> Supprimer\r\n                </button>\r\n            </div>\r\n            <div class=\"col-12 p-2\">\r\n                <div class=\"mb-4\">\r\n                    <div class=\"row\" v-for=\"(item2, index2) in item.Preferred_Starting_Time\">\r\n                        <div class=\"col-5\">\r\n                            <label class=\"form-label\">Jour :</label>\r\n                            <select class=\"form-control\" v-model=\"item2.Day\">\r\n                                <option v-for=\"day in formData.selectedDays\" :key=\"day\" :value=\"day\">{{ day }}</option>\r\n                            </select>\r\n                        </div>\r\n                        <div class=\"col-5\">\r\n                            <label class=\"form-label\">Heure :</label>\r\n                            <select class=\"form-control\" v-model=\"item2.Hour\">\r\n                                <option v-for=\"period in formData.periods.filter(period => period.name !== '')\" :key=\"period.name\" :value=\"period.name\">{{ period.name }}</option>\r\n                            </select>\r\n                        </div>\r\n                        <div class=\"col-2 mt-4\">\r\n                            <button type=\"button\" class=\"btn btn-danger btn-sm\" @click=\"removeDuration(index, index2)\">\r\n                                <i class=\"fas fa-trash\"></i>\r\n                            </button>\r\n                        </div>\r\n                    </div>\r\n                    <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addDuration(index)\">\r\n                        <i class=\"fas fa-plus me-1\"></i>Ajouter une période\r\n                    </button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <button type=\"button\" class=\"btn btn-primary btn-add\" @click=\"addConstraint\">\r\n            <i class=\"fas fa-plus me-1\"></i>Ajouter\r\n        </button>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport toastr from 'toastr';\r\n\r\nexport default {\r\n    name: 'ConstraintActivityPreferredStartingTimes',\r\n    props: {\r\n        formData: {\r\n            type: Object,\r\n            required: true\r\n        }\r\n    },\r\n    mounted() {\r\n        toastr.options = {\r\n            closeButton: true,\r\n            progressBar: true,\r\n            positionClass: 'toast-top-right',\r\n            timeOut: 3000\r\n        };\r\n    },\r\n    methods: {\r\n        addConstraint() {\r\n            this.formData.ConstraintActivityPreferredStartingTimes.push({\r\n                Activity_Id: '',\r\n                Preferred_Starting_Time: [{Day: '', Hour: ''}]\r\n            });\r\n        },\r\n        removeConstraint(index) {\r\n            this.formData.ConstraintActivityPreferredStartingTimes.splice(index, 1);\r\n        },\r\n        addDuration(index) {\r\n            this.formData.ConstraintRoomNotAvailableTimes[index].Preferred_Starting_Time.push({\r\n                Day: '',\r\n                Hour: ''\r\n            });\r\n        },\r\n        removeDuration(index, i) {\r\n            if (this.formData.ConstraintRoomNotAvailableTimes[index].Preferred_Starting_Time.length > 1) {\r\n                this.formData.ConstraintRoomNotAvailableTimes[index].Preferred_Starting_Time.splice(i, 1);\r\n            } else {\r\n                toastr.warning(\"Vous devez avoir au moins une péride.\");\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n    .item1{\r\n        border: 1px solid #dee2e6;\r\n        border-radius: 0.25rem;\r\n        background-color: #f8f9fa;\r\n    }\r\n</style>"],"mappings":";AAiDA,OAAOA,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACXC,IAAI,EAAE,0CAA0C;EAChDC,KAAK,EAAE;IACHC,QAAQ,EAAE;MACNC,IAAI,EAAEC,MAAM;MACZC,QAAQ,EAAE;IACd;EACJ,CAAC;EACDC,OAAOA,CAAA,EAAG;IACNP,MAAM,CAACQ,OAAM,GAAI;MACbC,WAAW,EAAE,IAAI;MACjBC,WAAW,EAAE,IAAI;MACjBC,aAAa,EAAE,iBAAiB;MAChCC,OAAO,EAAE;IACb,CAAC;EACL,CAAC;EACDC,OAAO,EAAE;IACLC,aAAaA,CAAA,EAAG;MACZ,IAAI,CAACX,QAAQ,CAACY,wCAAwC,CAACC,IAAI,CAAC;QACxDC,WAAW,EAAE,EAAE;QACfC,uBAAuB,EAAE,CAAC;UAACC,GAAG,EAAE,EAAE;UAAEC,IAAI,EAAE;QAAE,CAAC;MACjD,CAAC,CAAC;IACN,CAAC;IACDC,gBAAgBA,CAACC,KAAK,EAAE;MACpB,IAAI,CAACnB,QAAQ,CAACY,wCAAwC,CAACQ,MAAM,CAACD,KAAK,EAAE,CAAC,CAAC;IAC3E,CAAC;IACDE,WAAWA,CAACF,KAAK,EAAE;MACf,IAAI,CAACnB,QAAQ,CAACsB,+BAA+B,CAACH,KAAK,CAAC,CAACJ,uBAAuB,CAACF,IAAI,CAAC;QAC9EG,GAAG,EAAE,EAAE;QACPC,IAAI,EAAE;MACV,CAAC,CAAC;IACN,CAAC;IACDM,cAAcA,CAACJ,KAAK,EAAEK,CAAC,EAAE;MACrB,IAAI,IAAI,CAACxB,QAAQ,CAACsB,+BAA+B,CAACH,KAAK,CAAC,CAACJ,uBAAuB,CAACU,MAAK,GAAI,CAAC,EAAE;QACzF,IAAI,CAACzB,QAAQ,CAACsB,+BAA+B,CAACH,KAAK,CAAC,CAACJ,uBAAuB,CAACK,MAAM,CAACI,CAAC,EAAE,CAAC,CAAC;MAC7F,OAAO;QACH3B,MAAM,CAAC6B,OAAO,CAAC,uCAAuC,CAAC;MAC3D;IACJ;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}