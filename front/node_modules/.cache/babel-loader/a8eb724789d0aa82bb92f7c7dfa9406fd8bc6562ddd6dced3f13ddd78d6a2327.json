onstraint.teacher);\r\n          return `Enseignant: ${teacher?.name || 'Inconnu'}, Périodes: ${\r\n            constraint.unavailablePeriods.map(p => `${p.day} ${p.hour}`).join(', ')\r\n          }`;\r\n        case 'ConstraintTeacherMaxDaysPerWeek':\r\n          const teacherMax = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherMax?.name || 'Inconnu'}, Max: ${constraint.maxDays} jours`;\r\n        case 'ConstraintTeacherMinDaysPerWeek':\r\n          const teacherMin = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherMin?.name || 'Inconnu'}, Min: ${constraint.minDays} jours`;\r\n        case 'ConstraintTeacherNoTwoConsecutiveDays':\r\n          const teacherNoTwo = this.teachers.find(t => t.id === constraint.teacher);\r\n          return `Enseignant: ${teacherNoTwo?.name || 'Inconnu'}`;\r\n        default:\r\n          return JSON.stringify(constraint);\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.constraints-table {\r\n  margin-top: 30px;\r\n}\r\n\r\n.table {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n}\r\n\r\n.table th, .table td {\r\n  border: 1px solid #ddd;\r\n  padding: 8px;\r\n  text-align: left;\r\n}\r\n\r\n.table th {\r\n  background-color: #f2f2f2;\r\n}\r\n</style>"],"mappings":";;;AA2BA,eAAe;EACbA,KAAK,EAAE;IACLC,WAAW,EAAEC,KAAK;IAClBC,QAAQ,EAAED;EACZ,CAAC;EACDE,OAAO,EAAE;IACPC,WAAWA,CAACC,IAAI,EAAE;MAChB,MAAMC,KAAI,GAAI;QACZ,sBAAsB,EAAE,gBAAgB;QACxC,oCAAoC,EAAE,2BAA2B;QACjE,iCAAiC,EAAE,mBAAmB;QACtD,iCAAiC,EAAE,mBAAmB;QACtD,uCAAuC,EAAE;MAC3C,CAAC;MACD,OAAOA,KAAK,CAACD,IAAI,KAAKA,IAAI;IAC5B,CAAC;IACDE,UAAUA,CAACC,UAAU,EAAE;MACrB,QAAOA,UAAU,CAACH,IAAI;QACpB,KAAK,sBAAsB;UACzB,OAAO,SAASG,UAAU,CAACC,GAAG,YAAYD,UAAU,CAACE,IAAI,EAAE;QAC7D,KAAK,oCAAoC;UACvC,MAAMC,OAAM,GAAI,IAAI,CAACT,QAAQ,CAACU,IAAI,CAACC,CAAA,IAAKA,CAAC,CAACC,EAAC,KAAMN,UAAU,CAACG,OAAO,CAAC;UACpE,OAAO,eAAeA,OAAO,EAAEI,IAAG,IAAK,SAAS,eAC9CP,UAAU,CAACQ,kBAAkB,CAACC,GA